			<Item class="Script" referent="RBX14A0F2E1B4E94CF4A8CABE21E7F8805A">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ZoneEggsRoot = Workspace:WaitForChild("ZoneEggs")

local HOLD_DURATION = 0
local MAX_DISTANCE = 10
local MAX_CARRIED_EGGS = 4

local claimedEggs: { [Instance]: boolean } = {}
local eggPromptAnchors: { [Instance]: BasePart } = {}

local function isInActiveEggsFolder(inst: Instance): boolean
	local current = inst.Parent
	while current and current ~= ZoneEggsRoot do
		if current.Name == "ActiveEggs" then
			return true
		end
		current = current.Parent
	end
	return false
end

local function getEggPosition(egg: Instance): Vector3?
	if egg:IsA("Model") or egg:IsA("BasePart") then
		return egg:GetPivot().Position
	end
	return nil
end

local function cleanupAnchor(egg: Instance)
	local anchor = eggPromptAnchors[egg]
	eggPromptAnchors[egg] = nil
	if anchor and anchor.Parent then
		anchor:Destroy()
	end
end

local function getOrCreateCarriedFolder(character: Model): Folder
	local folder = character:FindFirstChild("CarriedEggs")
	if folder and folder:IsA("Folder") then
		return folder
	end
	local newFolder = Instance.new("Folder")
	newFolder.Name = "CarriedEggs"
	newFolder.Parent = character
	return newFolder
end

-- Tracks carried eggs in Character.CarriedEggs without attaching a 3D model over the head
local function addCarriedEggModel(player: Player, egg: Instance): boolean
	local character = player.Character
	if not character then
		return false
	end

	local carriedFolder = getOrCreateCarriedFolder(character)
	if #carriedFolder:GetChildren() >= MAX_CARRIED_EGGS then
		return false
	end

	local eggType = tostring(egg:GetAttribute("EggType") or egg.Name)
	local luckyPercent = egg:GetAttribute("LuckyPercent")
	local worldOrEvent = egg:GetAttribute("WorldOrEvent")

	local carriedEntry = Instance.new("Configuration")
	carriedEntry.Name = eggType
	carriedEntry:SetAttribute("EggType", eggType)
	if luckyPercent ~= nil then
		carriedEntry:SetAttribute("LuckyPercent", luckyPercent)
	end
	if worldOrEvent ~= nil then
		carriedEntry:SetAttribute("WorldOrEvent", worldOrEvent)
	end
	carriedEntry.Parent = carriedFolder

	return true
end

local function attachPickupPrompt(egg: Instance)
	if claimedEggs[egg] or eggPromptAnchors[egg] then
		return
	end
	if not (egg:IsA("Model") or egg:IsA("BasePart")) then
		return
	end
	if egg:GetAttribute("IsSpawnedEgg") ~= true then
		return
	end

	local pos = getEggPosition(egg)
	if not pos then
		return
	end

	local anchor = Instance.new("Part")
	anchor.Name = "EggPromptAnchor"
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = CFrame.new(pos)
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Parent = egg.Parent

	eggPromptAnchors[egg] = anchor

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "EggPickupPrompt"
	prompt.ActionText = "Pick Up"
	prompt.ObjectText = tostring(egg:GetAttribute("EggType") or egg.Name)
	prompt.HoldDuration = HOLD_DURATION
	prompt.MaxActivationDistance = MAX_DISTANCE
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor

	prompt.Triggered:Connect(function(player: Player)
		if claimedEggs[egg] or not egg.Parent then
			return
		end
		if not addCarriedEggModel(player, egg) then
			return
		end

		claimedEggs[egg] = true
		prompt.Enabled = false
		cleanupAnchor(egg)
		egg:Destroy()
	end)

	egg.Destroying:Connect(function()
		cleanupAnchor(egg)
	end)
end

local function inspectDescendant(desc: Instance)
	if isInActiveEggsFolder(desc) and desc:GetAttribute("IsSpawnedEgg") == true then
		attachPickupPrompt(desc)
	end
end

for _, desc in ipairs(ZoneEggsRoot:GetDescendants()) do
	inspectDescendant(desc)
end

ZoneEggsRoot.DescendantAdded:Connect(function(desc)
	task.defer(inspectDescendant, desc)
end)

ZoneEggsRoot.DescendantRemoving:Connect(function(desc)
	claimedEggs[desc] = nil
	cleanupAnchor(desc)
end)]]></ProtectedString>
