		<Item class="Folder" referent="RBX9F0AF8237A2D406891BDF85FC7FC6FF2">
			<Properties><string name="Name">Config</string></Properties>
			<Item class="ModuleScript" referent="RBXA14EF0FF0979532D612FB40B5CCED661">
			<Properties>
				<Content name="LinkedSource"><null/></Content>
				<ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage/PetConfig
-- Shared settings + helpers for the hatch / pet collection / pet scaling system.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PetConfig = {}

PetConfig.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }

-- Same colours your hotbar uses for egg names.
PetConfig.RarityColors = {
	Common = Color3.fromRGB(245, 245, 245),
	Uncommon = Color3.fromRGB(110, 235, 120),
	Rare = Color3.fromRGB(80, 185, 255),
	Epic = Color3.fromRGB(255, 195, 50),
	Legendary = Color3.fromRGB(255, 85, 65),
	Mythic = Color3.fromRGB(200, 95, 255),
}

-- Looks for Pets folders inside any World<number> folder (World1, World2, etc.).
PetConfig.PetsFolderName = "Pets"

-- What can hatch from each egg. Numbers are weights (they don't need to add up to 100).
-- Example: a Common Egg gives a Common pet 80% of the time, Uncommon 17%, Rare 3%.
PetConfig.EggOdds = {
	Common = { Common = 100 },
	Uncommon = { Uncommon = 100 },
	Rare = { Rare = 100 },
	Epic = { Epic = 100 },
	Legendary = { Legendary = 100 },
	Mythic = { Mythic = 100 },
}

-- Small-to-big pet scale range & weighted size tiers.
PetConfig.SizeRange = {
	Min = 0.2,
	Max = 2.5,
	Default = 1.0,
}

PetConfig.SizeTiers = {
	{ Name = "Tiny", Weight = 12, Min = 0.2, Max = 0.65 },
	{ Name = "Normal", Weight = 63, Min = 0.85, Max = 1.25 },
	{ Name = "Big", Weight = 18, Min = 1.3, Max = 1.85 },
	{ Name = "Giant", Weight = 7, Min = 1.9, Max = 2.5 },
}

-- Built-in Roblox sounds. Swap for your own asset ids (rbxassetid://123) any time.
PetConfig.Sounds = {
	Crack = "rbxasset://sounds/snap.mp3",
	Burst = "rbxasset://sounds/impact_water.mp3",
	Reveal = "rbxasset://sounds/electronicpingshort.wav",
}

local rng = Random.new()

function PetConfig.GetRarityIndex(rarity: string): number
	return table.find(PetConfig.RarityOrder, rarity) or 1
end

-- "CommonEgg" / "Common Egg" / "Legendary" -> "Common" / "Common" / "Legendary"
function PetConfig.GetEggRarity(eggType: any): string
	local name = tostring(eggType or "")
	name = (name:gsub("%s+", ""))
	name = (name:gsub("Egg$", ""))
	if table.find(PetConfig.RarityOrder, name) then
		return name
	end
	return "Common"
end

-- Returns all Pets folders across World1, World2, etc. (or a specific world if worldName is given).
function PetConfig.GetPetsFolders(worldName: string?): { Instance }
	local folders: { Instance } = {}

	if worldName then
		local world = ReplicatedStorage:FindFirstChild(worldName)
		local petsFolder = world and world:FindFirstChild(PetConfig.PetsFolderName)
		if petsFolder then
			table.insert(folders, petsFolder)
		end
		return folders
	end

	local worldFolders: { Instance } = {}
	for _, child in ipairs(ReplicatedStorage:GetChildren()) do
		if child.Name:match("^World%d+$") then
			table.insert(worldFolders, child)
		end
	end

	table.sort(worldFolders, function(a, b)
		local na = tonumber(a.Name:match("%d+")) or 0
		local nb = tonumber(b.Name:match("%d+")) or 0
		if na ~= nb then
			return na < nb
		end
		return a.Name < b.Name
	end)

	for _, world in ipairs(worldFolders) do
		local petsFolder = world:FindFirstChild(PetConfig.PetsFolderName)
		if petsFolder then
			table.insert(folders, petsFolder)
		end
	end

	-- Fallback if a standalone Pets folder exists directly under ReplicatedStorage.
	if #folders == 0 then
		local directPets = ReplicatedStorage:FindFirstChild(PetConfig.PetsFolderName)
		if directPets then
			table.insert(folders, directPets)
		end
	end

	return folders
end

-- Keeps single-folder compatibility (returns the first Pets folder found).
function PetConfig.GetPetsFolder(worldName: string?): Instance?
	return PetConfig.GetPetsFolders(worldName)[1]
end

function PetConfig.GetPetsOfRarity(rarity: string, worldName: string?): { Model }
	local list: { Model } = {}
	for _, folder in ipairs(PetConfig.GetPetsFolders(worldName)) do
		local sub = folder:FindFirstChild(rarity)
		if sub then
			for _, child in ipairs(sub:GetChildren()) do
				if child:IsA("Model") then
					table.insert(list, child)
				end
			end
		end
	end
	return list
end

-- Returns the pet template model and its rarity, or nil if it doesn't exist.
function PetConfig.FindPet(petName: string, worldName: string?): (Model?, string?)
	for _, folder in ipairs(PetConfig.GetPetsFolders(worldName)) do
		for _, rarity in ipairs(PetConfig.RarityOrder) do
			local sub = folder:FindFirstChild(rarity)
			local model = sub and sub:FindFirstChild(petName)
			if model and model:IsA("Model") then
				return model, rarity
			end
		end
	end
	return nil, nil
end

-- Every pet in the game, sorted by rarity then name. Used by the inventory UI.
function PetConfig.GetAllPets(worldName: string?): { { Name: string, Rarity: string, Model: Model } }
	local list = {}
	for _, rarity in ipairs(PetConfig.RarityOrder) do
		for _, model in ipairs(PetConfig.GetPetsOfRarity(rarity, worldName)) do
			table.insert(list, { Name = model.Name, Rarity = rarity, Model = model })
		end
	end
	table.sort(list, function(a, b)
		local ra, rb = PetConfig.GetRarityIndex(a.Rarity), PetConfig.GetRarityIndex(b.Rarity)
		if ra ~= rb then
			return ra < rb
		end
		return a.Name < b.Name
	end)
	return list
end

function PetConfig.GetDisplayName(petName: string): string
	local name = (petName:gsub("^animal%-", ""))
	name = (name:gsub("%-", " "))
	return (name:gsub("(%a)([%w]*)", function(first, rest)
		return first:upper() .. rest
	end))
end

local function weightedPick(weights: { [string]: number }): string
	local total = 0
	for _, w in pairs(weights) do
		total += w
	end
	local roll = rng:NextNumber() * total
	local last = "Common"
	for _, rarity in ipairs(PetConfig.RarityOrder) do
		local w = weights[rarity]
		if w then
			last = rarity
			roll -= w
			if roll <= 0 then
				return rarity
			end
		end
	end
	return last
end

-- Picks a random pet for an egg. Returns petName, rarity (or nil, nil if no pets exist).
function PetConfig.RollPet(eggType: any, worldName: string?): (string?, string?)
	local eggRarity = PetConfig.GetEggRarity(eggType)
	local odds = PetConfig.EggOdds[eggRarity] or PetConfig.EggOdds.Common

	-- Only roll rarities that actually have pet models.
	local usable = {}
	for rarity, weight in pairs(odds) do
		if weight > 0 and #PetConfig.GetPetsOfRarity(rarity, worldName) > 0 then
			usable[rarity] = weight
		end
	end
	if next(usable) == nil then
		for _, rarity in ipairs(PetConfig.RarityOrder) do
			if #PetConfig.GetPetsOfRarity(rarity, worldName) > 0 then
				usable[rarity] = 1
			end
		end
	end
	if next(usable) == nil then
		return nil, nil
	end

	local rarity = weightedPick(usable)
	local pets = PetConfig.GetPetsOfRarity(rarity, worldName)
	local pet = pets[rng:NextInteger(1, #pets)]
	return pet.Name, rarity
end

-- Rolls a random small-to-big scale (0.2 to 2.5) and tier label ("Tiny", "Normal", "Big", "Giant").
function PetConfig.RollPetScale(): (number, string)
	local totalWeight = 0
	for _, tier in ipairs(PetConfig.SizeTiers) do
		totalWeight += tier.Weight
	end

	local roll = rng:NextNumber() * totalWeight
	local chosen = PetConfig.SizeTiers[1]
	for _, tier in ipairs(PetConfig.SizeTiers) do
		roll -= tier.Weight
		if roll <= 0 then
			chosen = tier
			break
		end
	end

	local rawScale = rng:NextNumber(chosen.Min, chosen.Max)
	local roundedScale = math.floor(rawScale * 100 + 0.5) / 100
	return math.clamp(roundedScale, PetConfig.SizeRange.Min, PetConfig.SizeRange.Max), chosen.Name
end

-- Applies a clamped scale to a pet Model and records it as an attribute.
function PetConfig.ApplyPetScale(model: Model, scale: number?)
	local finalScale = math.clamp(
		scale or PetConfig.SizeRange.Default,
		PetConfig.SizeRange.Min,
		PetConfig.SizeRange.Max
	)
	model:ScaleTo(finalScale)
	model:SetAttribute("PetScale", finalScale)
end

return PetConfig]]></ProtectedString>
				<string name="ScriptGuid">{C1AB53DF-83D6-47C3-8DFE-516CFC0CB65D}</string>
