			</Item>
				<Item class="LocalScript" referent="RBXB87F2843C2BD4950B1F1F13B41E1264E">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local eggPlacedEvent = ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("EggPlacedEvent")

local connectedTools = {}

local function connectTool(tool)
	if not tool:IsA("Tool") or connectedTools[tool] then
		return
	end

	connectedTools[tool] = true
	tool.Activated:Connect(function()
		local character = player.Character
		if not character or tool.Parent ~= character then
			return
		end

		local target = mouse.Target
		if not target or target.Name ~= "RoamPets" or not target:IsA("BasePart") then
			warn("Aim directly at the RoamPets platform to place this egg.")
			return
		end

		eggPlacedEvent:FireServer(tool, mouse.Hit.Position, target)
	end)

	tool.Destroying:Connect(function()
		connectedTools[tool] = nil
	end)
end

local function watchCharacter(character)
	for _, child in ipairs(character:GetChildren()) do
		connectTool(child)
	end
	character.ChildAdded:Connect(connectTool)
end

if player.Character then
	watchCharacter(player.Character)
end
player.CharacterAdded:Connect(watchCharacter)
]]></ProtectedString>
