			<Item class="LocalScript" referent="RBXE42DFCF29D434D19B260668D5C0FFA62">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local gui = script.Parent

local toggleButton = gui:WaitForChild("PetsButton") :: TextButton
local badge = toggleButton:WaitForChild("NewBadge") :: Frame
local panel = gui:WaitForChild("Panel") :: Frame
local panelScale = panel:WaitForChild("PanelScale") :: UIScale
local closeButton = panel:WaitForChild("CloseButton") :: TextButton
local hatchedEvent = ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("PetHatched")

local isOpen = false

local function setOpen(open: boolean)
	if open == isOpen then
		return
	end
	isOpen = open

	if open then
		badge.Visible = false
		panelScale.Scale = 0.85
		panel.Visible = true
		TweenService:Create(
			panelScale,
			TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = 1 }
		):Play()
	else
		local closeTween = TweenService:Create(
			panelScale,
			TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Scale = 0.85 }
		)
		closeTween.Completed:Connect(function()
			if not isOpen then
				panel.Visible = false
			end
		end)
		closeTween:Play()
	end
end

toggleButton.Activated:Connect(function()
	setOpen(not isOpen)
end)

closeButton.Activated:Connect(function()
	setOpen(false)
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.P then
		setOpen(not isOpen)
	end
end)

hatchedEvent.OnClientEvent:Connect(function(_egg, _petName, _rarity, ownerUserId)
	if ownerUserId == player.UserId then
		task.delay(3, function()
			if not isOpen then
				badge.Visible = true
			end
		end)
	end
end)
]]></ProtectedString>
