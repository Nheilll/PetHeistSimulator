					<token name="RunContext">0</token>
					<string name="ScriptGuid">{5083BA2F-B93C-41C7-9871-C41FBC6BBDB5}</string>
					<BinaryString name="AttributesSerialize"/>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">EggPlacement</string>
					<BinaryString name="SerializedOverrides"/>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">7dd26ea6dd5377dc0b15c7f000005869</UniqueId>
				</Properties>
			</Item>
				<Item class="LocalScript" referent="RBXDE2C33D2D7E244F3B289BAB82BF4E6E1">
				<Properties>
					<ProtectedString name="Source"><![CDATA[
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local bases = Workspace:WaitForChild("Bases")

local ANIMATION_TIME = 1.2
local EXTRA_GAP = 0.02
local GUI_EXTRA_HEIGHT = 0.5

local animatedEggs = {}

local function findSurface(egg)
	local eggPosition = egg:GetPivot().Position
	local closestPart = nil
	local closestDistance = math.huge

	for _, object in ipairs(bases:GetDescendants()) do
		if object:IsA("BasePart") and object.Name == "RoamPets" then
			local localPosition =
				object.CFrame:PointToObjectSpace(eggPosition)

			local halfSize = object.Size * 0.5

			local insideX =
				math.abs(localPosition.X) <= halfSize.X + 2

			local insideZ =
				math.abs(localPosition.Z) <= halfSize.Z + 2

			if insideX and insideZ then
				local distance =
					(object.Position - eggPosition).Magnitude

				if distance < closestDistance then
					closestDistance = distance
					closestPart = object
				end
			end
		end
	end

	return closestPart
end

local function getRootPart(egg)
	if egg.PrimaryPart then
		return egg.PrimaryPart
	end

	local root = egg:FindFirstChildWhichIsA("BasePart", true)

	if root then
		egg.PrimaryPart = root
	end

	return root
end

local function groundEgg(egg, surface)
	if not egg.Parent or not surface or not surface.Parent then
		return
	end

	local pivot = egg:GetPivot()
	local boxCF, boxSize = egg:GetBoundingBox()

	local bottomY = boxCF.Position.Y - boxSize.Y * 0.5
	local surfaceTopY = surface.Position.Y + surface.Size.Y * 0.5

	local correctionY = surfaceTopY + EXTRA_GAP - bottomY

	egg:PivotTo(
		pivot + Vector3.new(0, correctionY, 0)
	)
end

local function updateBillboards(egg)
	if not egg.Parent then
		return
	end

	local root = getRootPart(egg)

	if not root then
		return
	end

	local boxCF, boxSize = egg:GetBoundingBox()
	local topY = boxCF.Position.Y + boxSize.Y * 0.5

	local offsetY = topY - root.Position.Y + GUI_EXTRA_HEIGHT

	for _, object in ipairs(egg:GetDescendants()) do
		if object:IsA("BillboardGui") then
			object.Adornee = root
			object.StudsOffset = Vector3.new(0, offsetY, 0)
		end
	end
end

local function animateEgg(egg)
	if not egg:IsA("Model") or animatedEggs[egg] then
		return
	end

	if not egg:GetAttribute("_EggScalePrepared") then
		return
	end

	local defaultScale = egg:GetAttribute("_EggDefaultScale")
	local targetScale = egg:GetAttribute("_RolledEggScale")

	if typeof(defaultScale) ~= "number"
		or typeof(targetScale) ~= "number" then
		return
	end

	animatedEggs[egg] = true

	local surface = findSurface(egg)

	if not surface then
		warn("No RoamPets surface found for egg:", egg:GetFullName())
		animatedEggs[egg] = nil
		return
	end

	-- Make sure the original-size egg starts grounded.
	groundEgg(egg, surface)
	updateBillboards(egg)

	-- Normal-size eggs do not need an animation.
	if math.abs(defaultScale - targetScale) < 0.0001 then
		egg:ScaleTo(targetScale)
		groundEgg(egg, surface)
		updateBillboards(egg)
		return
	end

	local scaleValue = Instance.new("NumberValue")
	scaleValue.Value = defaultScale

	local changing = true

	local connection = scaleValue:GetPropertyChangedSignal("Value"):Connect(function()
		if not changing or not egg.Parent then
			return
		end

		egg:ScaleTo(scaleValue.Value)

		-- Recalculate grounding after every scale update.
		groundEgg(egg, surface)

		-- Keep the GUI above the changing egg.
		updateBillboards(egg)
	end)

	local tween = TweenService:Create(
		scaleValue,
		TweenInfo.new(
			ANIMATION_TIME,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Value = targetScale
		}
	)

	tween:Play()
	tween.Completed:Wait()

	changing = false

	if egg.Parent then
		egg:ScaleTo(targetScale)
		groundEgg(egg, surface)
		updateBillboards(egg)
	end

	connection:Disconnect()
	scaleValue:Destroy()
end

local function watchEgg(egg)
	if not egg:IsA("Model") then
		return
	end

	if egg:GetAttribute("_EggScalePrepared") then
		task.spawn(animateEgg, egg)
		return
	end

	egg:GetAttributeChangedSignal("_EggScalePrepared"):Connect(function()
		if egg:GetAttribute("_EggScalePrepared") then
			task.spawn(animateEgg, egg)
		end
	end)
end

-- Existing eggs.
for _, object in ipairs(bases:GetDescendants()) do
	if object:IsA("Model") then
		watchEgg(object)
	end
end

-- Newly placed eggs.
bases.DescendantAdded:Connect(function(object)
	if object:IsA("Model") then
		watchEgg(object)
	end
end)
]]></ProtectedString>
