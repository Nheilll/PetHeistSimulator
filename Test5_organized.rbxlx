			<Item class="ModuleScript" referent="RBXC557976ED38D49EFA5F2CA7A57B644EB">
			<Properties>
				<Content name="LinkedSource"><null/></Content>
				<ProtectedString name="Source"><![CDATA[local EggSpawnConfig = {}

EggSpawnConfig.FloorConfig = {
	Default = {
		Interval = 1.5,
		MaxActivePerZone = 8,
		HeightOffset = 2.5,
		SpreadRadius = 22,
		MinSpacing = 8,
		Eggs = {
			{ Name = "Common Egg", Weight = 50 },
			{ Name = "Uncommon Egg", Weight = 30 },
			{ Name = "Rare Egg", Weight = 14 },
			{ Name = "Epic Egg", Weight = 5 },
			{ Name = "Legendary Egg", Weight = 1 },
			{ Name = "Mythic Egg", Weight = 0 },
		},
	},
	World1 = {
		Interval = 1.5,
		MaxActivePerZone = 8,
		HeightOffset = 2.5,
		SpreadRadius = 22,
		MinSpacing = 8,
		Eggs = {
			{ Name = "Common Egg", Weight = 45 },
			{ Name = "Uncommon Egg", Weight = 28 },
			{ Name = "Rare Egg", Weight = 15 },
			{ Name = "Epic Egg", Weight = 8 },
			{ Name = "Legendary Egg", Weight = 3.5 },
			{ Name = "Mythic Egg", Weight = 0.5 },
		},
	},
	World2 = {
		Interval = 1.5,
		MaxActivePerZone = 8,
		HeightOffset = 2.5,
		SpreadRadius = 22,
		MinSpacing = 8,
		Eggs = {
			{ Name = "Uncommon Egg", Weight = 25 },
			{ Name = "Rare Egg", Weight = 30 },
			{ Name = "Epic Egg", Weight = 25 },
			{ Name = "Legendary Egg", Weight = 14 },
			{ Name = "Mythic Egg", Weight = 6 },
		},
	},
	HalloweenEvent = {
		Interval = 1.5,
		MaxActivePerZone = 8,
		HeightOffset = 2.5,
		SpreadRadius = 22,
		MinSpacing = 8,
		Eggs = {
			{ Name = "Rare Egg", Weight = 40 },
			{ Name = "Epic Egg", Weight = 35 },
			{ Name = "Legendary Egg", Weight = 18 },
			{ Name = "Mythic Egg", Weight = 7 },
		},
	},
}

EggSpawnConfig.SpawnZoneOverrides = {
	SpawnZone1 = {
		MaxActivePerZone = 8,
		SpreadRadius = 22,
		MinSpacing = 8,
		Eggs = {
			{ Name = "Common Egg", Weight = 55 },
			{ Name = "Uncommon Egg", Weight = 30 },
			{ Name = "Rare Egg", Weight = 15 },
			{ Name = "Epic Egg", Weight = 0 },
			{ Name = "Legendary Egg", Weight = 0 },
			{ Name = "Mythic Egg", Weight = 0 },
		},
	},
	SpawnZone2 = {
		MaxActivePerZone = 8,
		SpreadRadius = 22,
		MinSpacing = 8,
		Eggs = {
			{ Name = "Common Egg", Weight = 60 },
			{ Name = "Uncommon Egg", Weight = 50 },
			{ Name = "Rare Egg", Weight = 30 },
			{ Name = "Epic Egg", Weight = 0 },
			{ Name = "Legendary Egg", Weight = 0 },
			{ Name = "Mythic Egg", Weight = 0 },
		},
	},
}

-- Walks up from spawnZone inside ZoneEggs to find matching World/Event folder names
function EggSpawnConfig.GetZoneContextNames(spawnZone: BasePart, zoneEggsRoot: Instance): (string, string)
	local parentFolder = spawnZone.Parent
	local floorName = if parentFolder then parentFolder.Name else "Default"
	local worldOrEventName = floorName

	local current = parentFolder
	while current and current ~= zoneEggsRoot do
		if current:IsA("Folder") then
			local name = current.Name
			if name ~= "MainWorld" and name ~= "Events" and name ~= "ActiveEggs" then
				worldOrEventName = name
			end
		end
		current = current.Parent
	end

	return floorName, worldOrEventName
end

function EggSpawnConfig.GetZoneConfig(spawnZone: BasePart, zoneEggsRoot: Instance?)
	local floorName, worldOrEventName = floorName, "Default"
	if zoneEggsRoot then
		floorName, worldOrEventName = EggSpawnConfig.GetZoneContextNames(spawnZone, zoneEggsRoot)
	else
		local parentFolder = spawnZone.Parent
		floorName = if parentFolder then parentFolder.Name else "Default"
		worldOrEventName = floorName
	end

	local baseConfig = EggSpawnConfig.FloorConfig[floorName]
		or EggSpawnConfig.FloorConfig[worldOrEventName]
		or EggSpawnConfig.FloorConfig.Default

	local zoneOverride = EggSpawnConfig.SpawnZoneOverrides[spawnZone.Name]

	return {
		FloorName = floorName,
		WorldOrEventName = worldOrEventName,
		Interval = (zoneOverride and zoneOverride.Interval) or baseConfig.Interval,
		MaxActivePerZone = (zoneOverride and zoneOverride.MaxActivePerZone) or baseConfig.MaxActivePerZone,
		HeightOffset = (zoneOverride and zoneOverride.HeightOffset) or baseConfig.HeightOffset,
		SpreadRadius = (zoneOverride and zoneOverride.SpreadRadius) or baseConfig.SpreadRadius or 22,
		MinSpacing = (zoneOverride and zoneOverride.MinSpacing) or baseConfig.MinSpacing or 8,
		Eggs = (zoneOverride and zoneOverride.Eggs) or baseConfig.Eggs,
	}
end

return EggSpawnConfig]]></ProtectedString>
