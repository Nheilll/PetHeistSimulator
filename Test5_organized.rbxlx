			<Item class="ModuleScript" referent="RBXAC9304B0CF8146AB9E13F503CFAA6C17">
			<Properties>
				<Content name="LinkedSource"><null/></Content>
				<ProtectedString name="Source"><![CDATA[local EggScaleConfig = {}

EggScaleConfig.Settings = {
	BaseScale = 1,
	DefaultScale = 1,
	MinScale = 0.2,
	MaxScale = 2.5,
	ScaleHeightMultiplier = true,
	HeightOffsetFallback = 3.5,
}

local ATTRIBUTE_NAME = "_RolledEggScale"
local rng = Random.new()

function EggScaleConfig.GetScaleBounds()
	local minScale = tonumber(EggScaleConfig.Settings.MinScale) or 0.2
	local maxScale = tonumber(EggScaleConfig.Settings.MaxScale) or 2.5
	if minScale > maxScale then
		minScale, maxScale = maxScale, minScale
	end
	return minScale, maxScale
end

function EggScaleConfig.GetHeightOffset(scale)
	local baseHeight = tonumber(EggScaleConfig.Settings.HeightOffsetFallback) or 3.5
	if EggScaleConfig.Settings.ScaleHeightMultiplier then
		return baseHeight * (tonumber(scale) or EggScaleConfig.Settings.DefaultScale or 1)
	end
	return baseHeight
end

function EggScaleConfig.RollScale(eggModel)
	local minScale, maxScale = EggScaleConfig.GetScaleBounds()
	local hasValidModel = typeof(eggModel) == "Instance"

	if hasValidModel then
		local savedRolled = eggModel:GetAttribute(ATTRIBUTE_NAME)
		if typeof(savedRolled) == "number" and savedRolled > 0 then
			return math.clamp(savedRolled, minScale, maxScale)
		end
	end

	local rolledScale = rng:NextNumber(minScale, maxScale)

	if hasValidModel then
		eggModel:SetAttribute(ATTRIBUTE_NAME, rolledScale)
	end

	return rolledScale
end

return EggScaleConfig]]></ProtectedString>
