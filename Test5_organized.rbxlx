		<Item class="Folder" referent="RBX31850BCA084F4D03982B04DE8BC19525">
			<Properties><string name="Name">BaseServerScripts</string></Properties>
			<Item class="Script" referent="RBX2B6A056ACF324E08A27119A9FAFE8868">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

-- ============================================================================
-- SETTINGS
-- ============================================================================
local SETTINGS = {
	BasesFolderName = "Bases",
	MainWorldName = "MainWorld",
	SpawnPartName = "Spawn",
	TeleportOnJoin = true,
	SpawnHeightOffset = 3,
}

-- ============================================================================
-- REFERENCES & STATE
-- ============================================================================
local BasesRoot = Workspace:WaitForChild(SETTINGS.BasesFolderName)
local MainWorld = BasesRoot:WaitForChild(SETTINGS.MainWorldName)
local playerBases: { [number]: Instance } = {}

-- ============================================================================
-- HELPERS
-- ============================================================================
local function isBaseUnclaimed(base: Instance): boolean
	local ownerId = base:GetAttribute("OwnerId")
	return ownerId == nil or ownerId == 0
end

local function findAvailableBase(): Instance?
	for _, base in ipairs(MainWorld:GetChildren()) do
		if isBaseUnclaimed(base) then
			return base
		end
	end
	return nil
end

local function teleportCharacterToBase(player: Player, base: Instance)
	if not SETTINGS.TeleportOnJoin then
		return
	end

	local character = player.Character or player.CharacterAdded:Wait()
	local rootPart = character:WaitForChild("HumanoidRootPart", 5) :: BasePart?
	if not rootPart then
		return
	end

	local spawnPart = base:FindFirstChild(SETTINGS.SpawnPartName, true)
	if spawnPart and spawnPart:IsA("BasePart") then
		local topY = spawnPart.Position.Y + (spawnPart.Size.Y * 0.5) + SETTINGS.SpawnHeightOffset
		rootPart.CFrame = CFrame.new(spawnPart.Position.X, topY, spawnPart.Position.Z)
	elseif base:IsA("Model") then
		local pivot = base:GetPivot()
		rootPart.CFrame = pivot + Vector3.new(0, SETTINGS.SpawnHeightOffset, 0)
	elseif base:IsA("BasePart") then
		local topY = base.Position.Y + (base.Size.Y * 0.5) + SETTINGS.SpawnHeightOffset
		rootPart.CFrame = CFrame.new(base.Position.X, topY, base.Position.Z)
	end
end

local function claimBaseForPlayer(player: Player)
	if playerBases[player.UserId] then
		return
	end

	local base = findAvailableBase()
	if not base then
		warn("[BaseAssignServer] No available base found in MainWorld for " .. player.Name)
		return
	end

	playerBases[player.UserId] = base
	base:SetAttribute("OwnerId", player.UserId)
	base:SetAttribute("OwnerName", player.Name)
	player:SetAttribute("AssignedBase", base.Name)

	teleportCharacterToBase(player, base)

	player.CharacterAdded:Connect(function()
		if playerBases[player.UserId] == base then
			task.wait(0.1)
			teleportCharacterToBase(player, base)
		end
	end)
end

local function releaseBaseForPlayer(player: Player)
	local base = playerBases[player.UserId]
	playerBases[player.UserId] = nil

	if base and base.Parent then
		if base:GetAttribute("OwnerId") == player.UserId then
			base:SetAttribute("OwnerId", nil)
			base:SetAttribute("OwnerName", nil)
		end
	end

	if player.Parent then
		player:SetAttribute("AssignedBase", nil)
	end
end

-- ============================================================================
-- INITIALIZATION
-- ============================================================================
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(claimBaseForPlayer, player)
end

Players.PlayerAdded:Connect(claimBaseForPlayer)
Players.PlayerRemoving:Connect(releaseBaseForPlayer)]]></ProtectedString>
