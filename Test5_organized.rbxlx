			</Properties>
			<Item class="Folder" referent="RBX3CA09D7D04F44DB883E2EB5374111E4C">
				<Properties><string name="Name">EggScripts</string></Properties>
				<Item class="LocalScript" referent="RBXD02CF9B45988491FB8986C5606EE5006">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ZoneEggsRoot = Workspace:WaitForChild("ZoneEggs")

local BOB_HEIGHT = 0.6
local BOB_SPEED = 3
local SPIN_SPEED = 1.2

local eggData: { [Instance]: { startCFrame: CFrame, timeOffset: number } } = {}

local function isInActiveEggsFolder(inst: Instance): boolean
	local current = inst.Parent
	while current and current ~= ZoneEggsRoot do
		if current.Name == "ActiveEggs" then
			return true
		end
		current = current.Parent
	end
	return false
end

local function isAnimatableEgg(inst: Instance): boolean
	return (inst:IsA("Model") or inst:IsA("BasePart"))
		and isInActiveEggsFolder(inst)
		and not isInActiveEggsFolder(inst.Parent or inst)
end

local function registerEgg(egg: Instance)
	if eggData[egg] then
		return
	end
	if egg:IsA("Model") or egg:IsA("BasePart") then
		task.wait(0.05)
		if egg.Parent and egg:IsDescendantOf(ZoneEggsRoot) and not eggData[egg] then
			eggData[egg] = {
				startCFrame = egg:GetPivot(),
				timeOffset = math.random() * 10,
			}
		end
	end
end

local function inspectDescendant(desc: Instance)
	if isAnimatableEgg(desc) then
		task.spawn(registerEgg, desc)
	end
end

for _, desc in ipairs(ZoneEggsRoot:GetDescendants()) do
	inspectDescendant(desc)
end

ZoneEggsRoot.DescendantAdded:Connect(inspectDescendant)

ZoneEggsRoot.DescendantRemoving:Connect(function(desc)
	eggData[desc] = nil
end)

RunService.RenderStepped:Connect(function()
	local now = os.clock()

	for egg, data in pairs(eggData) do
		if egg.Parent and egg:IsDescendantOf(ZoneEggsRoot) then
			local t = now + data.timeOffset
			local yOffset = math.sin(t * BOB_SPEED) * BOB_HEIGHT
			local spin = CFrame.Angles(0, t * SPIN_SPEED, 0)
			local targetCFrame = (data.startCFrame + Vector3.new(0, yOffset, 0)) * spin

			if egg:IsA("Model") then
				egg:PivotTo(targetCFrame)
			elseif egg:IsA("BasePart") then
				egg.CFrame = targetCFrame
			end
		else
			eggData[egg] = nil
		end
	end
end)]]></ProtectedString>
