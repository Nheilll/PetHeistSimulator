				<Properties><string name="Name">UIScripts</string></Properties>
				<Item class="LocalScript" referent="RBX862A07A5FE934B8EAE1EDF617F35DC60">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local gui = playerGui:WaitForChild("CarriedEggHotbarGui")
local hotbarFrame = gui:WaitForChild("HotbarFrame") :: Frame
local templatesFolder = gui:WaitForChild("Templates") :: Folder
local slotTemplate = templatesFolder:WaitForChild("EggSlotTemplate") :: Frame

local TITLE_COLORS = {
	Mythic = Color3.fromRGB(200, 95, 255),
	Legendary = Color3.fromRGB(255, 85, 65),
	Epic = Color3.fromRGB(255, 195, 50),
	Rare = Color3.fromRGB(80, 185, 255),
	Uncommon = Color3.fromRGB(110, 235, 120),
	Common = Color3.fromRGB(245, 245, 245),
}

local function getTitleColor(eggName: string): Color3
	for key, color in pairs(TITLE_COLORS) do
		if eggName:find(key) then
			return color
		end
	end
	return TITLE_COLORS.Common
end

local function findEggVisualTemplate(eggName: string, worldOrEvent: string?): Instance?
	local searchRoots: { Instance } = {}
	if worldOrEvent then
		local wf = ReplicatedStorage:FindFirstChild(worldOrEvent)
		if wf then
			local eggsSub = wf:FindFirstChild("Eggs")
			if eggsSub then
				table.insert(searchRoots, eggsSub)
			end
			table.insert(searchRoots, wf)
		end
	end

	local world1 = ReplicatedStorage:FindFirstChild("World1")
	if world1 then
		local eggsSub = world1:FindFirstChild("Eggs")
		if eggsSub then
			table.insert(searchRoots, eggsSub)
		end
		table.insert(searchRoots, world1)
	end

	for _, root in ipairs(searchRoots) do
		local found = root:FindFirstChild(eggName)
		if found and (found:IsA("Model") or found:IsA("BasePart")) then
			return found
		end
		if found and found:IsA("Folder") then
			local exact = found:FindFirstChild(eggName)
			if exact and (exact:IsA("Model") or exact:IsA("BasePart")) then
				return exact
			end
			for _, child in ipairs(found:GetChildren()) do
				if child:IsA("Model") or child:IsA("BasePart") then
					return child
				end
			end
		end
	end

	return nil
end

local function setupViewportPreview(viewport: ViewportFrame, eggName: string, worldOrEvent: string?)
	local sourceModel = findEggVisualTemplate(eggName, worldOrEvent)
	if not sourceModel then
		return
	end

	local preview = sourceModel:Clone()
	for _, desc in ipairs(preview:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.Anchored = true
			desc.CanCollide = false
		elseif desc:IsA("WeldConstraint") or desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("ProximityPrompt") then
			desc:Destroy()
		end
	end

	local worldModel = Instance.new("WorldModel")
	worldModel.Parent = viewport
	preview.Parent = worldModel

	local cf, size
	if preview:IsA("Model") then
		preview:PivotTo(CFrame.new(0, 0, 0))
		cf, size = preview:GetBoundingBox()
	elseif preview:IsA("BasePart") then
		preview.CFrame = CFrame.new(0, 0, 0)
		cf, size = preview.CFrame, preview.Size
	else
		return
	end

	local maxDim = math.max(size.X, size.Y, size.Z, 1)
	local cam = Instance.new("Camera")
	cam.FieldOfView = 35
	cam.CFrame = CFrame.lookAt(
		cf.Position + Vector3.new(0, maxDim * 0.2, maxDim * 2.1),
		cf.Position
	)
	cam.Parent = viewport
	viewport.CurrentCamera = cam
end

local function clearSlots()
	for _, child in ipairs(hotbarFrame:GetChildren()) do
		if child:IsA("GuiObject") and child.Name ~= "SlotList" then
			child:Destroy()
		end
	end
end

local function refreshHotbar()
	clearSlots()

	local character = player.Character
	local carriedFolder = character and character:FindFirstChild("CarriedEggs")
	if not carriedFolder then
		hotbarFrame.Visible = false
		return
	end

	local count = 0
	for _, entry in ipairs(carriedFolder:GetChildren()) do
		count += 1
		local eggName = tostring(entry:GetAttribute("EggType") or entry.Name)
		local worldOrEvent = entry:GetAttribute("WorldOrEvent")

		local slot = slotTemplate:Clone()
		slot.Name = "EggSlot_" .. tostring(count)
		slot.LayoutOrder = count
		slot.Visible = true
		slot.Parent = hotbarFrame

		local title = slot:FindFirstChild("ItemTitle") :: TextLabel?
		if title then
			title.Text = eggName
			title.TextColor3 = getTitleColor(eggName)
		end

		local viewport = slot:FindFirstChild("EggViewport") :: ViewportFrame?
		if viewport then
			setupViewportPreview(viewport, eggName, if typeof(worldOrEvent) == "string" then worldOrEvent else nil)
		end

		local badge = slot:FindFirstChild("BadgeIcon") :: ImageLabel?
		if badge then
			badge.Visible = true
		end
	end

	hotbarFrame.Visible = (count > 0)
end

local folderConnections: { RBXScriptConnection } = {}

local function disconnectFolderConnections()
	for _, conn in ipairs(folderConnections) do
		conn:Disconnect()
	end
	table.clear(folderConnections)
end

local function hookCarriedFolder(folder: Instance)
	disconnectFolderConnections()
	table.insert(folderConnections, folder.ChildAdded:Connect(refreshHotbar))
	table.insert(folderConnections, folder.ChildRemoved:Connect(refreshHotbar))
	refreshHotbar()
end

local function hookCharacter(character: Model)
	disconnectFolderConnections()
	local existingFolder = character:FindFirstChild("CarriedEggs")
	if existingFolder then
		hookCarriedFolder(existingFolder)
	end

	character.ChildAdded:Connect(function(child)
		if child.Name == "CarriedEggs" then
			hookCarriedFolder(child)
		end
	end)
	refreshHotbar()
end

if player.Character then
	hookCharacter(player.Character)
end
player.CharacterAdded:Connect(hookCharacter)]]></ProtectedString>
