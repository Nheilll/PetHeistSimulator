					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">EggIdleAnimation</string>
					<BinaryString name="SerializedOverrides"/>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">1d63ed214ea769d30b16e3bd00001069</UniqueId>
				</Properties>
			</Item>
				<Item class="LocalScript" referent="RBXDDBC2FEBC9D24D2483DDC7205FA53288">
				<Properties>
					<ProtectedString name="Source"><![CDATA[
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local remoteFolder = ReplicatedStorage:WaitForChild("RemoteEvents")

local crackAnimationEvent = remoteFolder:WaitForChild(
	"EggCrackAnimation"
)

-- SETTINGS
local ANIMATION_SPEED = 0.09

local CRACK_ANGLES = {
	[1] = math.rad(3),
	[2] = math.rad(6),
	[3] = math.rad(10)
}

local animatingEggs = {}

local function playCrackAnimation(egg, crackNumber)
	if not egg or not egg.Parent then
		return
	end

	if animatingEggs[egg] then
		return
	end

	animatingEggs[egg] = true

	local originalPivot = egg:GetPivot()
	local angle = CRACK_ANGLES[crackNumber] or math.rad(5)

	local pivotValue = Instance.new("CFrameValue")
	pivotValue.Value = originalPivot

	local connection = pivotValue:GetPropertyChangedSignal("Value"):Connect(function()
		if egg.Parent then
			egg:PivotTo(pivotValue.Value)
		end
	end)

	local function tweenTo(offset)
		if not egg.Parent then
			return
		end

		local tween = TweenService:Create(
			pivotValue,
			TweenInfo.new(
				ANIMATION_SPEED,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),
			{
				Value = originalPivot * offset
			}
		)

		tween:Play()
		tween.Completed:Wait()
	end

	-- Shake left and right.
	for i = 1, 3 do
		if not egg.Parent then
			break
		end

		tweenTo(CFrame.Angles(0, 0, angle))
		tweenTo(CFrame.Angles(0, 0, -angle))
	end

	-- Return to original position.
	if egg.Parent then
		tweenTo(CFrame.new())
		egg:PivotTo(originalPivot)
	end

	connection:Disconnect()
	pivotValue:Destroy()

	animatingEggs[egg] = nil
end

crackAnimationEvent.OnClientEvent:Connect(function(egg, crackNumber)
	if typeof(egg) ~= "Instance" then
		return
	end

	if not egg:IsA("Model") then
		return
	end

	if typeof(crackNumber) ~= "number" then
		return
	end

	task.spawn(function()
		playCrackAnimation(egg, crackNumber)
	end)
end)
]]></ProtectedString>
