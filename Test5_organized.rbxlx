					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">EggPlacedServer</string>
					<BinaryString name="SerializedOverrides"/>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">327a1cabcd7d9a560b15850f0000d776</UniqueId>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX4F6B62D8C19849AD98BE08850BB74536">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local EggSpawnConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("EggSpawnConfig"))
local ZoneEggsRoot = Workspace:WaitForChild("ZoneEggs")
local FallbackWorld = ReplicatedStorage:WaitForChild("World1")

local UPRIGHT_FIX = CFrame.Angles(0, 0, math.pi)
local watchedZones: { [BasePart]: boolean } = {}

local function isInsideActiveEggs(inst: Instance): boolean
	local current = inst.Parent
	while current and current ~= ZoneEggsRoot do
		if current.Name == "ActiveEggs" then
			return true
		end
		current = current.Parent
	end
	return false
end

local function isSpawnZonePart(inst: Instance): boolean
	if not inst:IsA("BasePart") then
		return false
	end
	if inst:GetAttribute("IsSpawnedEgg") then
		return false
	end
	if inst.Name == "ActiveEggs" or inst.Name == "EggPromptAnchor" or isInsideActiveEggs(inst) then
		return false
	end
	if not inst.Parent or inst.Parent == ZoneEggsRoot then
		return false
	end
	return true
end

-- Checks the zone's world/event folder in ReplicatedStorage first, then falls back to World1
local function getCandidateEggRoots(spawnZone: BasePart): { Instance }
	local roots: { Instance } = {}
	local seen: { [Instance]: boolean } = {}

	local function addRoot(folder: Instance?)
		if not folder or seen[folder] then
			return
		end
		seen[folder] = true
		local eggsSub = folder:FindFirstChild("Eggs")
		if eggsSub and not seen[eggsSub] then
			seen[eggsSub] = true
			table.insert(roots, eggsSub)
		end
		table.insert(roots, folder)
	end

	local current = spawnZone.Parent
	while current and current ~= ZoneEggsRoot do
		if current:IsA("Folder") then
			addRoot(ReplicatedStorage:FindFirstChild(current.Name))
		end
		current = current.Parent
	end

	addRoot(FallbackWorld)
	return roots
end

local function getEggTemplate(spawnZone: BasePart, eggName: string): Instance?
	local roots = getCandidateEggRoots(spawnZone)

	for _, root in ipairs(roots) do
		local direct = root:FindFirstChild(eggName)
		if direct and (direct:IsA("Model") or direct:IsA("BasePart")) then
			return direct
		end

		local eggFolder = root:FindFirstChild(eggName)
		if eggFolder then
			local exact = eggFolder:FindFirstChild(eggName)
			if exact and (exact:IsA("Model") or exact:IsA("BasePart")) then
				return exact
			end
			for _, child in ipairs(eggFolder:GetChildren()) do
				if child:IsA("Model") or child:IsA("BasePart") then
					return child
				end
			end
		end
	end

	return nil
end

local function pickWeightedEgg(pool): string?
	local totalWeight = 0
	for _, entry in ipairs(pool) do
		if entry.Weight and entry.Weight > 0 then
			totalWeight += entry.Weight
		end
	end

	if totalWeight <= 0 then
		return nil
	end

	local roll = math.random() * totalWeight
	local sum = 0
	for _, entry in ipairs(pool) do
		local w = math.max(0, entry.Weight or 0)
		if w > 0 then
			sum += w
			if roll <= sum then
				return entry.Name
			end
		end
	end

	return nil
end

local function anchorAllParts(instance: Instance)
	if instance:IsA("BasePart") then
		instance.Anchored = true
		instance.CanCollide = false
	end
	for _, desc in ipairs(instance:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.Anchored = true
			desc.CanCollide = false
		end
	end
end

local function getOrCreateActiveEggsFolder(spawnZone: BasePart): Folder
	local folder = spawnZone:FindFirstChild("ActiveEggs")
	if folder and folder:IsA("Folder") then
		return folder
	end
	local newFolder = Instance.new("Folder")
	newFolder.Name = "ActiveEggs"
	newFolder.Parent = spawnZone
	return newFolder
end

local function getActiveEggItems(activeEggsFolder: Folder): { Instance }
	local items = {}
	for _, child in ipairs(activeEggsFolder:GetChildren()) do
		if child:IsA("Model") or child:IsA("BasePart") then
			table.insert(items, child)
		end
	end
	return items
end

local function getNearbyReferenceEggs(spawnZone: BasePart, activeEggsFolder: Folder): { Instance }
	local refs = getActiveEggItems(activeEggsFolder)
	local scopeRoot = spawnZone.Parent or ZoneEggsRoot

	for _, desc in ipairs(scopeRoot:GetDescendants()) do
		if (desc:IsA("Model") or desc:IsA("BasePart")) and desc:GetAttribute("IsSpawnedEgg") then
			if not desc:IsDescendantOf(activeEggsFolder) then
				table.insert(refs, desc)
			end
		end
	end

	return refs
end

local function findClearPosition(spawnZone: BasePart, activeEggsFolder: Folder, config): Vector3
	local radius = config.SpreadRadius or 22
	local minSpacing = config.MinSpacing or 8
	local heightOffset = config.HeightOffset or 2.5
	local baseY = spawnZone.Position.Y + (spawnZone.Size.Y * 0.5) + heightOffset
	local existingEggs = getNearbyReferenceEggs(spawnZone, activeEggsFolder)

	for _ = 1, 40 do
		local angle = math.random() * math.pi * 2
		local dist = math.sqrt(math.random()) * radius
		local candidate = Vector3.new(
			spawnZone.Position.X + math.cos(angle) * dist,
			baseY,
			spawnZone.Position.Z + math.sin(angle) * dist
		)

		local tooClose = false
		for _, otherEgg in ipairs(existingEggs) do
			local otherPos = otherEgg:GetPivot().Position
			local flatDist = (Vector3.new(otherPos.X, 0, otherPos.Z) - Vector3.new(candidate.X, 0, candidate.Z)).Magnitude
			if flatDist < minSpacing then
				tooClose = true
				break
			end
		end

		if not tooClose then
			return candidate
		end
	end

	local bestPos: Vector3? = nil
	local bestScore = -1
	for _ = 1, 25 do
		local angle = math.random() * math.pi * 2
		local dist = math.sqrt(math.random()) * radius
		local candidate = Vector3.new(
			spawnZone.Position.X + math.cos(angle) * dist,
			baseY,
			spawnZone.Position.Z + math.sin(angle) * dist
		)
		local minDistToAny = math.huge
		for _, otherEgg in ipairs(existingEggs) do
			local otherPos = otherEgg:GetPivot().Position
			local d = (Vector3.new(otherPos.X, 0, otherPos.Z) - Vector3.new(candidate.X, 0, candidate.Z)).Magnitude
			if d < minDistToAny then
				minDistToAny = d
			end
		end
		if minDistToAny > bestScore then
			bestScore = minDistToAny
			bestPos = candidate
		end
	end

	return bestPos or Vector3.new(spawnZone.Position.X, baseY, spawnZone.Position.Z)
end

local function buildUprightCFrame(pos: Vector3, yaw: number): CFrame
	return CFrame.new(pos) * CFrame.Angles(0, yaw, 0) * UPRIGHT_FIX
end

local function smoothRiseTo(egg: Instance, targetPos: Vector3, yaw: number)
	local startPos = targetPos - Vector3.new(0, 1.5, 0)
	local startCF = buildUprightCFrame(startPos, yaw)
	local endCF = buildUprightCFrame(targetPos, yaw)

	egg:PivotTo(startCF)

	local proxy = Instance.new("CFrameValue")
	proxy.Value = startCF

	local conn = proxy.Changed:Connect(function(newCF)
		if egg.Parent then
			egg:PivotTo(newCF)
		end
	end)

	local tween = TweenService:Create(
		proxy,
		TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Value = endCF }
	)

	tween.Completed:Connect(function()
		conn:Disconnect()
		proxy:Destroy()
	end)

	tween:Play()
end

local function spawnEggInZone(spawnZone: BasePart, config): boolean
	local activeEggsFolder = getOrCreateActiveEggsFolder(spawnZone)
	local maxActive = config.MaxActivePerZone or 8
	if #getActiveEggItems(activeEggsFolder) >= maxActive then
		return false
	end

	local chosenName = pickWeightedEgg(config.Eggs)
	if not chosenName then
		return false
	end

	local template = getEggTemplate(spawnZone, chosenName)
	if not template then
		warn("[EggSpawner] Missing template for:", chosenName, "in zone:", spawnZone:GetFullName())
		return false
	end

	local pos = findClearPosition(spawnZone, activeEggsFolder, config)
	local yaw = math.random() * math.pi * 2

	local egg = template:Clone()
	anchorAllParts(egg)
	egg:SetAttribute("IsSpawnedEgg", true)
	egg:SetAttribute("EggType", chosenName)
	egg:SetAttribute("WorldOrEvent", config.WorldOrEventName)

	local luckyAttr = template:GetAttribute("LuckyPercent")
	if luckyAttr ~= nil then
		egg:SetAttribute("LuckyPercent", luckyAttr)
	end

	egg.Parent = activeEggsFolder
	smoothRiseTo(egg, pos, yaw)
	return true
end

local function startSpawnZoneLoop(spawnZone: BasePart)
	if watchedZones[spawnZone] then
		return
	end
	watchedZones[spawnZone] = true

	local config = EggSpawnConfig.GetZoneConfig(spawnZone, ZoneEggsRoot)
	getOrCreateActiveEggsFolder(spawnZone)

	task.spawn(function()
		local maxActive = config.MaxActivePerZone or 8
		for _ = 1, maxActive do
			if spawnZone.Parent == nil or not spawnZone:IsDescendantOf(ZoneEggsRoot) then
				break
			end
			if not spawnEggInZone(spawnZone, config) then
				break
			end
			task.wait(0.05)
		end

		while spawnZone.Parent ~= nil and spawnZone:IsDescendantOf(ZoneEggsRoot) do
			spawnEggInZone(spawnZone, config)
			task.wait(config.Interval)
		end
		watchedZones[spawnZone] = nil
	end)
end

local function inspectInstance(inst: Instance)
	if isSpawnZonePart(inst) then
		startSpawnZoneLoop(inst :: BasePart)
	end
end

for _, desc in ipairs(ZoneEggsRoot:GetDescendants()) do
	inspectInstance(desc)
end

ZoneEggsRoot.DescendantAdded:Connect(inspectInstance)]]></ProtectedString>
