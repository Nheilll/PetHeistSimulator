			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">3a2ca2a8d0006ec00b1535dc000003c1</UniqueId>
		</Properties>
		<Item class="Folder" referent="RBX54498819AD874269875C835159E3236F">
			<Properties>
				<Content name="ExplorerIconContent">
					<null/>
				</Content>
				<Color3 name="IconTint">
					<R>0</R>
					<G>0</G>
					<B>0</B>
				</Color3>
				<BinaryString name="AttributesSerialize"/>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">EggServerScripts</string>
				<BinaryString name="SerializedOverrides"/>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">33a955381f64c2880b167d4b00000956</UniqueId>
