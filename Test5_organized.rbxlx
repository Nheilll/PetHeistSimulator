			<Item class="LocalScript" referent="RBX82E39D0D6AD94BCF821D1AFD209FBB45">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- LocalScript: StarterGui/PetBackpackGui/PetBackpackController
--
-- PET BAG UI
--   Equip   -> the pet's Tool is sent to the hotbar.
--   Unequip -> the Tool leaves the hotbar / hand and the pet is
--              back in the Pet Bag (it stays in PetInventory).
--
-- A card shows "Unequip" whenever that pet's Tool is on the hotbar
-- or in the player's hand, otherwise it shows "Equip".

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

local PetConfig = require(
	ReplicatedStorage:WaitForChild("Config"):WaitForChild("PetConfig")
)

local remotes = ReplicatedStorage:WaitForChild("RemoteEvents")
local equipEvent = remotes:WaitForChild("GrantPetTool") :: RemoteEvent
local unequipEvent = remotes:WaitForChild("StorePetTool") :: RemoteEvent

--------------------------------------------------
-- UI REFERENCES
--------------------------------------------------

local gui = script.Parent :: ScreenGui
gui.ResetOnSpawn = false
gui.Enabled = true
gui.DisplayOrder = math.max(gui.DisplayOrder, 15)

local backpackButton = gui:WaitForChild("BackpackButton") :: GuiButton
local panel = gui:WaitForChild("Panel") :: GuiObject
local grid = panel:WaitForChild("Grid") :: GuiObject
local cardTemplate = panel:WaitForChild("CardTemplate") :: GuiObject
local closeButton = panel:FindFirstChild("CloseButton", true) :: GuiButton?

-- Accepts the old misspelled name too.
local unequipAllButton = (
	gui:FindFirstChild("UnequipButton") or gui:FindFirstChild("UneqiupButton")
) :: GuiButton?

backpackButton.Active = true
backpackButton.Visible = true
cardTemplate.Visible = false
panel.Visible = false

if unequipAllButton then
	unequipAllButton.Visible = false
end

--------------------------------------------------
-- STATE
--------------------------------------------------

type PetEntry = {
	key: string,
	petName: string,
	index: number,
}

local currentEntries: { PetEntry } = {}
local cardsByKey: { [string]: GuiObject } = {}
local boundViewports: { [ViewportFrame]: string } = {}

local inventoryConnections: { RBXScriptConnection } = {}
local containerConnections: { RBXScriptConnection } = {}

local refreshQueued = false

--------------------------------------------------
-- NAME / INVENTORY HELPERS
--------------------------------------------------

local function normalizePetName(name: string): string
	local stripped = name:gsub("^animal%-", ""):gsub("^pet%-", "")

	if stripped == "" then
		return string.lower(name)
	end

	return string.lower(stripped)
end

local function getPetCount(petName: string): number
	local inventory = player:FindFirstChild("PetInventory")

	if not inventory then
		return 0
	end

	local target = normalizePetName(petName)

	for _, child in ipairs(inventory:GetChildren()) do
		if child:IsA("IntValue") and normalizePetName(child.Name) == target then
			return math.max(0, child.Value)
		end
	end

	return 0
end

local function getRarity(petName: string): string
	local _, rarity = PetConfig.FindPet(petName)
	return rarity or "Common"
end

--------------------------------------------------
-- HOTBAR / HAND TOOLS
--------------------------------------------------

local function getToolPetName(tool: Tool): string?
	local attr = tool:GetAttribute("PetName")

	if typeof(attr) == "string" and attr ~= "" and tool:GetAttribute("IsPetTool") == true then
		return attr
	end

	return nil
end

-- Pet Tools in the hotbar (Backpack) or in the hand (Character).
local function getPlayerPetTools(petName: string?): { Tool }
	local found: { Tool } = {}
	local target = if petName then normalizePetName(petName) else nil

	local containers = {
		player:FindFirstChildOfClass("Backpack"),
		player.Character,
	}

	for _, container in ipairs(containers) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") then
					local name = getToolPetName(child)

					if name and (not target or normalizePetName(name) == target) then
						table.insert(found, child)
					end
				end
			end
		end
	end

	return found
end

-- Copy #1 is equipped first, then #2, ...
local function isEntryEquipped(entry: PetEntry): boolean
	return entry.index <= #getPlayerPetTools(entry.petName)
end

--------------------------------------------------
-- VIEWPORT PREVIEW
--------------------------------------------------

local function clearViewport(viewport: ViewportFrame)
	for _, child in ipairs(viewport:GetChildren()) do
		if child:IsA("WorldModel") or child:IsA("Camera") then
			child:Destroy()
		end
	end

	viewport.CurrentCamera = nil
end

local function applyPetViewport(viewport: ViewportFrame, petName: string, petModel: Model?)
	if boundViewports[viewport] == petName and viewport:FindFirstChildWhichIsA("WorldModel") then
		return
	end

	clearViewport(viewport)
	boundViewports[viewport] = nil

	if not petModel then
		return
	end

	local worldModel = Instance.new("WorldModel")
	worldModel.Parent = viewport

	local clone = petModel:Clone()

	for _, desc in ipairs(clone:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.Anchored = true
			desc.CanCollide = false
			desc.CanTouch = false
			desc.CanQuery = false
		elseif desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("ProximityPrompt") then
			desc:Destroy()
		end
	end

	clone.Parent = worldModel
	clone:PivotTo(CFrame.identity)

	local cf, size = clone:GetBoundingBox()
	local maxDim = math.max(size.X, size.Y, size.Z, 0.75)
	local focus = cf.Position

	local camera = Instance.new("Camera")
	camera.FieldOfView = 35
	camera.CFrame = CFrame.lookAt(
		focus + Vector3.new(maxDim * 0.85, maxDim * 0.65, -maxDim * 2.3),
		focus
	)
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	boundViewports[viewport] = petName
end

--------------------------------------------------
-- ENTRIES  (one card per owned copy)
--------------------------------------------------

local function getSeparatedPetEntries(): { PetEntry }
	local entries: { PetEntry } = {}
	local petNames: { string } = {}

	local inventory = player:FindFirstChild("PetInventory")

	if inventory then
		for _, child in ipairs(inventory:GetChildren()) do
			if child:IsA("IntValue") and child.Value > 0 then
				table.insert(petNames, child.Name)
			end
		end
	end

	-- Rarity first (Common -> Mythic), then name.
	table.sort(petNames, function(a, b)
		local ra = PetConfig.GetRarityIndex(getRarity(a))
		local rb = PetConfig.GetRarityIndex(getRarity(b))

		if ra ~= rb then
			return ra < rb
		end

		return a < b
	end)

	for _, petName in ipairs(petNames) do
		for i = 1, getPetCount(petName) do
			table.insert(entries, {
				key = string.format("%s#%d", petName, i),
				petName = petName,
				index = i,
			})
		end
	end

	return entries
end

--------------------------------------------------
-- UNEQUIP ALL BUTTON
--------------------------------------------------

local function refreshUnequipAllButton()
	if unequipAllButton then
		unequipAllButton.Visible = panel.Visible and #getPlayerPetTools(nil) > 0
	end
end

--------------------------------------------------
-- CARD REFRESH
--------------------------------------------------

local function refreshCard(entry: PetEntry, card: GuiObject)
	local count = getPetCount(entry.petName)

	if count <= 0 or entry.index > count then
		card.Visible = false
		return
	end

	card.Visible = true

	local equipped = isEntryEquipped(entry)

	local petModel = PetConfig.FindPet(entry.petName)
	local rarity = getRarity(entry.petName)
	local rarityColor = PetConfig.RarityColors[rarity] or Color3.new(1, 1, 1)
	local displayName = PetConfig.GetDisplayName(entry.petName)

	local nameLabel = card:FindFirstChild("NameLabel", true) :: TextLabel?
	local rarityLabel = card:FindFirstChild("RarityLabel", true) :: TextLabel?
	local sizeLabel = card:FindFirstChild("SizeLabel", true) :: TextLabel?
	local actionButton = card:FindFirstChild("ActionButton", true) :: TextButton?
	local viewport = card:FindFirstChild("Preview", true) :: ViewportFrame?
	local stroke = card:FindFirstChildWhichIsA("UIStroke")

	if nameLabel then
		nameLabel.Text = if count > 1
			then string.format("%s #%d", displayName, entry.index)
			else displayName
	end

	if rarityLabel then
		rarityLabel.Text = string.upper(rarity)
		rarityLabel.TextColor3 = rarityColor
	end

	if sizeLabel then
		local minScale = petModel and petModel:GetAttribute("MinScale")
		local maxScale = petModel and petModel:GetAttribute("MaxScale")

		sizeLabel.Text = if typeof(minScale) == "number" and typeof(maxScale) == "number"
			then string.format("Size: %.1fx - %.1fx", minScale, maxScale)
			else "Size: Standard"
	end

	if actionButton then
		actionButton.Active = true
		actionButton.Text = if equipped then "Unequip" else "Equip"
		actionButton.BackgroundColor3 = if equipped
			then Color3.fromRGB(220, 120, 45)
			else Color3.fromRGB(55, 135, 255)
	end

	if viewport then
		applyPetViewport(viewport, entry.petName, petModel)
	end

	if stroke then
		stroke.Color = rarityColor
	end
end

local function refreshAllCards()
	for _, entry in ipairs(currentEntries) do
		local card = cardsByKey[entry.key]

		if card and card.Parent then
			refreshCard(entry, card)
		end
	end

	refreshUnequipAllButton()
end

-- Many Tool events can fire at once (moving a Tool = remove + add).
local function queueRefresh()
	if refreshQueued then
		return
	end

	refreshQueued = true

	task.defer(function()
		refreshQueued = false
		refreshAllCards()
	end)
end

--------------------------------------------------
-- BUILD CARDS
--------------------------------------------------

local function rebuildBackpack()
	for key, card in pairs(cardsByKey) do
		card:Destroy()
		cardsByKey[key] = nil
	end

	currentEntries = getSeparatedPetEntries()

	for order, entry in ipairs(currentEntries) do
		local card = cardTemplate:Clone()
		card.Name = entry.key
		card.LayoutOrder = order
		card.Visible = true
		card.Parent = grid

		cardsByKey[entry.key] = card

		local actionButton = card:FindFirstChild("ActionButton", true) :: TextButton?

		if actionButton then
			local busy = false

			actionButton.MouseButton1Click:Connect(function()
				if busy or getPetCount(entry.petName) <= 0 then
					return
				end

				busy = true

				if isEntryEquipped(entry) then
					-- Hotbar / hand  ->  Pet Bag
					unequipEvent:FireServer(entry.petName)
				else
					-- Pet Bag  ->  Hotbar
					equipEvent:FireServer(entry.petName)
				end

				task.delay(0.3, function()
					busy = false
				end)
			end)
		end

		refreshCard(entry, card)
	end

	refreshUnequipAllButton()
end

--------------------------------------------------
-- BUTTONS
--------------------------------------------------

backpackButton.MouseButton1Click:Connect(function()
	panel.Visible = not panel.Visible

	if panel.Visible then
		rebuildBackpack()
	end

	refreshUnequipAllButton()
end)

if closeButton then
	closeButton.Active = true

	closeButton.MouseButton1Click:Connect(function()
		panel.Visible = false
		refreshUnequipAllButton()
	end)
end

if unequipAllButton then
	unequipAllButton.Active = true

	unequipAllButton.MouseButton1Click:Connect(function()
		unequipEvent:FireServer(nil, true)
	end)
end

--------------------------------------------------
-- LIVE UPDATES: hotbar / hand
--------------------------------------------------

local function clearContainerConnections()
	for _, conn in ipairs(containerConnections) do
		conn:Disconnect()
	end

	table.clear(containerConnections)
end

local function hookContainer(container: Instance?)
	if not container then
		return
	end

	table.insert(containerConnections, container.ChildAdded:Connect(queueRefresh))
	table.insert(containerConnections, container.ChildRemoved:Connect(queueRefresh))
end

local function bindContainers()
	clearContainerConnections()

	hookContainer(player:FindFirstChildOfClass("Backpack"))
	hookContainer(player.Character)
end

-- A new Backpack is created every time the character respawns.
player.ChildAdded:Connect(function(child)
	if child:IsA("Backpack") then
		bindContainers()
		queueRefresh()
	end
end)

player.CharacterAdded:Connect(function()
	bindContainers()
	queueRefresh()
end)

--------------------------------------------------
-- LIVE UPDATES: PetInventory
--------------------------------------------------

local function bindInventory()
	for _, conn in ipairs(inventoryConnections) do
		conn:Disconnect()
	end

	table.clear(inventoryConnections)

	local inventory = player:WaitForChild("PetInventory")

	local function watch(obj: Instance)
		if obj:IsA("IntValue") then
			table.insert(inventoryConnections, obj.Changed:Connect(rebuildBackpack))
		end
	end

	for _, child in ipairs(inventory:GetChildren()) do
		watch(child)
	end

	table.insert(inventoryConnections, inventory.ChildAdded:Connect(function(child)
		watch(child)
		rebuildBackpack()
	end))

	table.insert(inventoryConnections, inventory.ChildRemoved:Connect(rebuildBackpack))
end

--------------------------------------------------
-- START
--------------------------------------------------

bindContainers()
bindInventory()
rebuildBackpack()

print("[PetBackpackController] Pet Bag loaded.")
]]></ProtectedString>
