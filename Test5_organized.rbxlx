			<Item class="Script" referent="RBXF642BA4BE53A017D44EBCB93774A8F5A">
				<Properties>
					<ProtectedString name="Source"><![CDATA[
-- Script: ServerScriptService/EggServerScripts/PetHatchServer
--
-- FEATURES:
-- 1. Hatches an egg after 3 cracks.
-- 2. Rolls a random pet using PetConfig.
-- 3. Plays the existing hatch animation.
-- 4. Awards the existing Pet Tool after animation completion.
-- 5. Validates the egg owner on the server.
-- 6. Prevents duplicate pet awards.
-- 7. Updates PetInventory.
-- 8. Saves pets using DataStore.
-- 9. Removes the hatched egg.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")

--------------------------------------------------
-- CONFIGURATION
--------------------------------------------------

local PetConfig = require(
	ReplicatedStorage:WaitForChild("Config"):WaitForChild("PetConfig")
)

local bases = Workspace:WaitForChild("Bases")

-- Your existing pet Tools
local petToolsFolder = ReplicatedStorage
	:WaitForChild("World1")
	:WaitForChild("PetTools")

local DATASTORE_NAME = "PlayerPets_v1"
local AUTOSAVE_INTERVAL = 60
local DATA_RETRIES = 4

local ANIMATION_TIMEOUT = 6.5
local EGG_DESTROY_DELAY = 6.5

--------------------------------------------------
-- REMOTE EVENTS
--------------------------------------------------

local remoteFolder = ReplicatedStorage:FindFirstChild("RemoteEvents")

if not remoteFolder then
	remoteFolder = Instance.new("Folder")
	remoteFolder.Name = "RemoteEvents"
	remoteFolder.Parent = ReplicatedStorage
end

local petHatchedEvent = remoteFolder:FindFirstChild("PetHatched")

if not petHatchedEvent then
	petHatchedEvent = Instance.new("RemoteEvent")
	petHatchedEvent.Name = "PetHatched"
	petHatchedEvent.Parent = remoteFolder
end

local hatchAnimDoneEvent = remoteFolder:FindFirstChild("HatchAnimationDone")

if not hatchAnimDoneEvent then
	hatchAnimDoneEvent = Instance.new("RemoteEvent")
	hatchAnimDoneEvent.Name = "HatchAnimationDone"
	hatchAnimDoneEvent.Parent = remoteFolder
end

--------------------------------------------------
-- DATASTORE
--------------------------------------------------

local store: DataStore? = nil

do
	local success, result = pcall(function()
		return DataStoreService:GetDataStore(DATASTORE_NAME)
	end)

	if success then
		store = result
	else
		warn("[PetHatch] DataStore unavailable:", result)
	end
end

type Profile = {
	Pets: { [string]: number },
	CanSave: boolean,
	Dirty: boolean,
	Saving: boolean,
}

local profiles: { [Player]: Profile } = {}
local activeSaves = 0

--------------------------------------------------
-- DATA HELPERS
--------------------------------------------------

local function withRetries(fn: () -> any): (boolean, any)
	local lastError

	for attempt = 1, DATA_RETRIES do
		local success, result = pcall(fn)

		if success then
			return true, result
		end

		lastError = result
		task.wait(attempt * 1.5)
	end

	return false, lastError
end

local function keyFor(userId: number): string
	return "Player_" .. userId
end

--------------------------------------------------
-- PET INVENTORY
--------------------------------------------------

local function getReplicaFolder(player: Player): Folder
	local folder = player:FindFirstChild("PetInventory")

	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "PetInventory"
		folder.Parent = player
	end

	return folder
end

local function syncPet(
	player: Player,
	petName: string,
	count: number
)
	local _, rarity = PetConfig.FindPet(petName)

	if not rarity then
		return
	end

	local folder = getReplicaFolder(player)
	local value = folder:FindFirstChild(petName)

	if not value then
		value = Instance.new("IntValue")
		value.Name = petName
		value:SetAttribute("Rarity", rarity)
		value.Value = count
		value.Parent = folder
	else
		value.Value = count
	end
end

--------------------------------------------------
-- CREATE PET TOOL FROM PETTOOLS
--------------------------------------------------

local function createPetTool(
	player: Player,
	petName: string,
	rarity: string,
	hatchId: string
): boolean

	if not player or player.Parent ~= Players then
		return false
	end

	local backpack = player:FindFirstChildOfClass("Backpack")

	if not backpack then
		backpack = player:WaitForChild("Backpack", 10)
	end

	if not backpack then
		warn("[PetHatch] Backpack unavailable:", player.Name)
		return false
	end

	--------------------------------------------------
	-- DUPLICATE CHECK
	--------------------------------------------------

	local function alreadyHasTool(container: Instance?): boolean
		if not container then
			return false
		end

		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Tool")
				and item:GetAttribute("HatchId") == hatchId then

				return true
			end
		end

		return false
	end

	if alreadyHasTool(backpack)
		or alreadyHasTool(player.Character) then

		return true
	end

	--------------------------------------------------
	-- FIND ORIGINAL TOOL
	--------------------------------------------------

	local originalTool = petToolsFolder:FindFirstChild(petName)

	if not originalTool or not originalTool:IsA("Tool") then
		warn(
			"[PetHatch] Missing pet Tool in World1.PetTools:",
			petName
		)

		return false
	end

	--------------------------------------------------
	-- CLONE ORIGINAL TOOL
	--------------------------------------------------

	local petTool = originalTool:Clone()

	petTool:SetAttribute("PetName", petName)
	petTool:SetAttribute("Rarity", rarity)
	petTool:SetAttribute("HatchId", hatchId)

	-- Preserve the original Tool appearance and contents.
	petTool.Parent = backpack

	print(
		"[PetHatch] Tool awarded:",
		player.Name,
		petName,
		rarity
	)

	return true
end

--------------------------------------------------
-- SAVE PROFILE
--------------------------------------------------

local function saveProfile(
	userId: number,
	profile: Profile
): boolean

	if not profile.CanSave or not store then
		return false
	end

	activeSaves += 1

	while profile.Saving do
		task.wait(0.1)
	end

	if not profile.Dirty then
		activeSaves -= 1
		return true
	end

	profile.Saving = true
	profile.Dirty = false

	local snapshot = table.clone(profile.Pets)

	local success, err = withRetries(function()
		return (store :: DataStore):UpdateAsync(
			keyFor(userId),
			function()
				return {
					Version = 1,
					Pets = snapshot,
				}
			end
		)
	end)

	profile.Saving = false
	activeSaves -= 1

	if not success then
		profile.Dirty = true

		warn(
			"[PetHatch] Save failed:",
			userId,
			err
		)
	end

	return success
end

--------------------------------------------------
-- LOAD PROFILE
--------------------------------------------------

local function loadProfile(player: Player)
	local profile = profiles[player]

	if not profile then
		return
	end

	local success, data = false, "DataStore unavailable"

	if store then
		success, data = withRetries(function()
			return (store :: DataStore):GetAsync(
				keyFor(player.UserId)
			)
		end)
	end

	if profiles[player] ~= profile then
		return
	end

	if success then

		if typeof(data) == "table"
			and typeof(data.Pets) == "table" then

			for name, count in pairs(data.Pets) do

				if typeof(name) == "string"
					and typeof(count) == "number"
					and count > 0 then

					-- Only load pets that still exist in PetConfig.
					local _, rarity = PetConfig.FindPet(name)

					if rarity then
						profile.Pets[name] =
							(profile.Pets[name] or 0)
							+ math.floor(count)
					end
				end
			end
		end

		profile.CanSave = true

	else
		profile.CanSave = false

		warn(
			"[PetHatch] Could not load:",
			player.Name,
			data
		)
	end

	for name, count in pairs(profile.Pets) do
		syncPet(player, name, count)
	end

	player:SetAttribute("PetsSaveEnabled", profile.CanSave)
	player:SetAttribute("PetsLoaded", true)
end

--------------------------------------------------
-- AWARD PET
--------------------------------------------------


--------------------------------------------------
-- AWARD PET
-- ONLY adds pet to PetInventory.
-- DOES NOT create or give a Tool.
--------------------------------------------------

local function awardPet(
	player: Player,
	petName: string,
	rarity: string,
	hatchId: string
)
	local profile = profiles[player]

	if not profile then
		return
	end

	if player:GetAttribute("PetsLoaded") ~= true then
		warn("[PetHatch] Player data not loaded:", player.Name)
		return
	end

	-- Add pet to collection only.
	profile.Pets[petName] =
		(profile.Pets[petName] or 0) + 1

	profile.Dirty = true

	-- Update replicated inventory.
	syncPet(
		player,
		petName,
		profile.Pets[petName]
	)

	-- Save collection.
	task.spawn(
		saveProfile,
		player.UserId,
		profile
	)

	print(
		"[PetHatch] Pet added to inventory:",
		player.Name,
		petName,
		rarity
	)
end

--------------------------------------------------
-- PLAYER CONNECTIONS
--------------------------------------------------

local function onPlayerAdded(player: Player)

	profiles[player] = {
		Pets = {},
		CanSave = false,
		Dirty = false,
		Saving = false,
	}

	getReplicaFolder(player)

	loadProfile(player)
end

local function onPlayerRemoving(player: Player)

	local profile = profiles[player]

	profiles[player] = nil

	if profile then
		saveProfile(player.UserId, profile)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

--------------------------------------------------
-- AUTOSAVE
--------------------------------------------------

task.spawn(function()

	while true do
		task.wait(AUTOSAVE_INTERVAL)

		for player, profile in pairs(profiles) do

			if profile.Dirty then
				task.spawn(
					saveProfile,
					player.UserId,
					profile
				)
			end
		end
	end
end)

--------------------------------------------------
-- SERVER SHUTDOWN SAVE
--------------------------------------------------

game:BindToClose(function()

	for player, profile in pairs(profiles) do
		task.spawn(
			saveProfile,
			player.UserId,
			profile
		)
	end

	while activeSaves > 0 do
		task.wait(0.1)
	end
end)

--------------------------------------------------
-- HATCHING SYSTEM
--------------------------------------------------

local pendingHatches: {
	[Model]: {
		petName: string,
		rarity: string,
		ownerId: number,
		hatchId: string,
		awarded: boolean,
	}
} = {}

local watched = setmetatable({}, {
	__mode = "k",
})

--------------------------------------------------
-- FINISH HATCH
--------------------------------------------------

local function finishHatchAward(egg: Model)

	local data = pendingHatches[egg]

	if not data or data.awarded then
		return
	end

	-- Prevent multiple awards.
	data.awarded = true

	local owner = Players:GetPlayerByUserId(data.ownerId)

	if owner then

		-- Wait for player data to finish loading.
		local deadline = os.clock() + 10

		while owner.Parent == Players
			and owner:GetAttribute("PetsLoaded") ~= true
			and os.clock() < deadline do

			task.wait(0.1)
		end

		if owner.Parent == Players then

			awardPet(
				owner,
				data.petName,
				data.rarity,
				data.hatchId
			)

		else
			warn("[PetHatch] Owner left before award.")
		end
	end

	-- Remove egg.
	task.delay(EGG_DESTROY_DELAY, function()

		if egg.Parent then
			egg:Destroy()
		end

		pendingHatches[egg] = nil
	end)
end

--------------------------------------------------
-- START HATCH
--------------------------------------------------

local function hatchEgg(egg: Model)

	if pendingHatches[egg] then
		return
	end

	-- Roll pet.
	local petName, rarity = PetConfig.RollPet(
		egg:GetAttribute("EggType")
	)

	if not petName or not rarity then
		warn("[PetHatch] No pet selected.")
		return
	end

	-- Validate owner.
	local ownerId = egg:GetAttribute("PlacedByUserId")

	local resolvedOwnerId =
		if typeof(ownerId) == "number"
		then ownerId
		else 0

	if resolvedOwnerId <= 0 then
		warn("[PetHatch] Invalid egg owner:", egg.Name)
		return
	end

	-- Check that the owner exists.
	if not Players:GetPlayerByUserId(resolvedOwnerId) then
		warn("[PetHatch] Egg owner is not in server:", resolvedOwnerId)
		return
	end

	-- Unique hatch identifier.
	local hatchId = HttpService:GenerateGUID(false)

	pendingHatches[egg] = {
		petName = petName,
		rarity = rarity,
		ownerId = resolvedOwnerId,
		hatchId = hatchId,
		awarded = false,
	}

	egg:SetAttribute("Hatched", true)

	print(
		string.format(
			"[PetHatch] %s hatched -> %s (%s)",
			egg.Name,
			petName,
			rarity
		)
	)

	-- Play existing animation on clients.
	petHatchedEvent:FireAllClients(
		egg,
		petName,
		rarity,
		resolvedOwnerId
	)

	-- Failsafe if animation completion is never received.
	task.delay(ANIMATION_TIMEOUT, function()
		finishHatchAward(egg)
	end)
end

--------------------------------------------------
-- ANIMATION COMPLETION
--------------------------------------------------

hatchAnimDoneEvent.OnServerEvent:Connect(function(
	player: Player,
	egg: unknown
)

	if typeof(egg) ~= "Instance"
		or not egg:IsA("Model") then

		return
	end

	local data = pendingHatches[egg]

	if not data then
		return
	end

	-- Only the egg owner can complete the hatch.
	if player.UserId ~= data.ownerId then

		warn(
			"[PetHatch] Unauthorized hatch completion:",
			player.Name
		)

		return
	end

	if data.awarded then
		return
	end

	-- Award after animation completion.
	finishHatchAward(egg)
end)

--------------------------------------------------
-- WATCH EGGS
--------------------------------------------------

local function watchEgg(egg: Instance)

	if not egg:IsA("Model")
		or egg:GetAttribute("EggType") == nil
		or watched[egg] then

		return
	end

	watched[egg] = true

	local function check()

		if egg:GetAttribute("HatchRequested") == true then
			hatchEgg(egg)
		end
	end

	egg:GetAttributeChangedSignal(
		"HatchRequested"
	):Connect(check)

	check()
end

--------------------------------------------------
-- EXISTING EGGS
--------------------------------------------------

for _, descendant in ipairs(bases:GetDescendants()) do
	watchEgg(descendant)
end

--------------------------------------------------
-- NEW EGGS
--------------------------------------------------

bases.DescendantAdded:Connect(function(descendant)
	task.defer(watchEgg, descendant)
end)

print("[PetHatch] Pet hatch system loaded successfully!")
]]></ProtectedString>
