			<Item class="LocalScript" referent="RBX9A5A6171DCAE45ADA5BD287811D8425D">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local gui = script.Parent

local panel = gui:WaitForChild("Panel") :: Frame
local statsLabel = panel:WaitForChild("StatsLabel") :: TextLabel
local filterBar = panel:WaitForChild("FilterBar") :: ScrollingFrame
local grid = panel:WaitForChild("Grid") :: ScrollingFrame
local saveWarning = panel:WaitForChild("SaveWarning") :: TextLabel
local cardTemplate = gui:WaitForChild("CardTemplate") :: Frame

local PetConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("PetConfig"))
ReplicatedStorage:WaitForChild("World1"):WaitForChild("Pets")
local inventory = player:WaitForChild("PetInventory")

local THEME = {
	Card = Color3.fromRGB(42, 45, 62),
	Backdrop = Color3.fromRGB(58, 62, 84),
	Text = Color3.fromRGB(255, 255, 255),
	SubText = Color3.fromRGB(170, 175, 195),
	Accent = Color3.fromRGB(255, 190, 60),
}

local catalog = PetConfig.GetAllPets()
local counts: { [string]: number } = {}
local cards: { [string]: any } = {}
local currentFilter = "All"

local function setupViewport(viewport: ViewportFrame, template: Model)
	for _, child in ipairs(viewport:GetChildren()) do
		if child:IsA("WorldModel") or child:IsA("Camera") then
			child:Destroy()
		end
	end

	local worldModel = Instance.new("WorldModel")
	worldModel.Parent = viewport

	local preview = template:Clone()
	for _, descendant in ipairs(preview:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
		elseif descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("ProximityPrompt") then
			descendant:Destroy()
		end
	end
	preview.Parent = worldModel
	preview:PivotTo(CFrame.new(0, 0, 0))

	local cf, size = preview:GetBoundingBox()
	local maxDim = math.max(size.X, size.Y, size.Z, 0.5)
	local focus = cf.Position

	local camera = Instance.new("Camera")
	camera.FieldOfView = 35
	camera.CFrame = CFrame.lookAt(focus + Vector3.new(maxDim * 0.8, maxDim * 0.6, -maxDim * 2.2), focus)
	camera.Parent = viewport
	viewport.CurrentCamera = camera
end

local function updateCard(petName: string)
	local card = cards[petName]
	if not card then
		return
	end

	local count = counts[petName] or 0
	local owned = count > 0
	local rarityColor = PetConfig.RarityColors[card.Entry.Rarity] or Color3.new(1, 1, 1)

	card.NameLabel.Text = if owned then PetConfig.GetDisplayName(petName) else "???"
	card.NameLabel.TextColor3 = if owned then THEME.Text else THEME.SubText
	card.RarityLabel.TextTransparency = if owned then 0 else 0.45
	if card.Stroke then
		card.Stroke.Transparency = if owned then 0 else 0.65
	end

	card.Viewport.Ambient = if owned then Color3.fromRGB(200, 200, 200) else Color3.new(0, 0, 0)
	card.Viewport.LightColor = if owned then Color3.fromRGB(140, 140, 140) else Color3.new(0, 0, 0)
	card.Viewport.BackgroundColor3 = if owned then THEME.Backdrop:Lerp(rarityColor, 0.18) else THEME.Backdrop

	card.CountBadge.Visible = count > 1
	card.CountLabel.Text = "x" .. count

	card.Frame.LayoutOrder = PetConfig.GetRarityIndex(card.Entry.Rarity) * 1000 + (if owned then 0 else 500) + card.Index
end

local function buildCard(entry, index: number)
	local rarityColor = PetConfig.RarityColors[entry.Rarity] or Color3.new(1, 1, 1)

	local frame = cardTemplate:Clone()
	frame.Name = entry.Name
	frame.Visible = true
	frame.Parent = grid

	local frameStroke = frame:FindFirstChildOfClass("UIStroke") :: UIStroke?
	if frameStroke then
		frameStroke.Color = rarityColor
	end

	local viewport = frame:WaitForChild("Preview") :: ViewportFrame
	setupViewport(viewport, entry.Model)

	local nameLabel = frame:WaitForChild("NameLabel") :: TextLabel
	local rarityLabel = frame:WaitForChild("RarityLabel") :: TextLabel
	rarityLabel.Text = string.upper(entry.Rarity)
	rarityLabel.TextColor3 = rarityColor

	local countBadge = frame:WaitForChild("CountBadge") :: Frame
	local countLabel = countBadge:WaitForChild("CountLabel") :: TextLabel

	cards[entry.Name] = {
		Entry = entry,
		Index = index,
		Frame = frame,
		Stroke = frameStroke,
		Viewport = viewport,
		NameLabel = nameLabel,
		RarityLabel = rarityLabel,
		CountBadge = countBadge,
		CountLabel = countLabel,
	}
	updateCard(entry.Name)
end

for index, entry in ipairs(catalog) do
	buildCard(entry, index)
end

local chips: { [string]: TextButton } = {}

local function refreshChips()
	for filterName, chip in pairs(chips) do
		local color = if filterName == "All" then THEME.Accent else (PetConfig.RarityColors[filterName] or THEME.Accent)
		local active = filterName == currentFilter
		chip.BackgroundColor3 = if active then color else THEME.Card
		chip.TextColor3 = if active then Color3.fromRGB(25, 25, 35) else color
	end
end

local function applyFilter(filterName: string)
	currentFilter = filterName
	for _, card in pairs(cards) do
		card.Frame.Visible = filterName == "All" or card.Entry.Rarity == filterName
	end
	grid.CanvasPosition = Vector2.zero
	refreshChips()
end

local function hookChip(chip: TextButton)
	local filterName = chip.Name
	chips[filterName] = chip
	chip.Activated:Connect(function()
		applyFilter(filterName)
	end)
end

for _, child in ipairs(filterBar:GetChildren()) do
	if child:IsA("TextButton") then
		hookChip(child)
	end
end
filterBar.ChildAdded:Connect(function(child)
	if child:IsA("TextButton") then
		hookChip(child)
	end
end)
applyFilter("All")

local function refreshStats()
	local ownedKinds, totalPets = 0, 0
	for petName, count in pairs(counts) do
		if cards[petName] and count > 0 then
			ownedKinds += 1
			totalPets += count
		end
	end
	if ownedKinds == 0 then
		statsLabel.Text = "Crack an egg to hatch your first pet!"
	else
		statsLabel.Text = string.format("Collected %d/%d  •  %d pets total", ownedKinds, #catalog, totalPets)
	end
end

local function trackValue(value: Instance)
	if not value:IsA("IntValue") then
		return
	end
	counts[value.Name] = value.Value
	updateCard(value.Name)
	refreshStats()

	value:GetPropertyChangedSignal("Value"):Connect(function()
		counts[value.Name] = value.Value
		updateCard(value.Name)
		refreshStats()
	end)
end

for _, child in ipairs(inventory:GetChildren()) do
	trackValue(child)
end
inventory.ChildAdded:Connect(trackValue)
inventory.ChildRemoved:Connect(function(child)
	counts[child.Name] = nil
	updateCard(child.Name)
	refreshStats()
end)
refreshStats()

local function refreshSaveWarning()
	saveWarning.Visible = player:GetAttribute("PetsSaveEnabled") == false
end
player:GetAttributeChangedSignal("PetsSaveEnabled"):Connect(refreshSaveWarning)
refreshSaveWarning()
]]></ProtectedString>
