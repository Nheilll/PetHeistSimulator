			<Item class="Script" referent="RBXF1BB64E267384EDC824457C98E1D4CBA">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local FallbackWorld = ReplicatedStorage:WaitForChild("World1")
local TOUCH_COOLDOWN = 0.5

local TOOL_NAME_MAP = {
	["Common Egg"] = "CommonEgg",
	["Uncommon Egg"] = "UncommonEgg",
	["Rare Egg"] = "RareEgg",
	["Epic Egg"] = "EpicEgg",
	["Legendary Egg"] = "Legendary",
	["Mythic Egg"] = "MythicEgg",
}

local hookedStations: { [BasePart]: boolean } = {}
local busyPlayers: { [Player]: boolean } = {}
local lastTouchTime: { [Player]: number } = {}

local function findEggToolTemplate(eggTypeName: string, worldOrEventName: string?): Tool?
	local roots: { Instance } = {}

	if worldOrEventName then
		local worldFolder = ReplicatedStorage:FindFirstChild(worldOrEventName)
		if worldFolder then
			local toolsSub = worldFolder:FindFirstChild("EggTools")
			if toolsSub then
				table.insert(roots, toolsSub)
			end
			table.insert(roots, worldFolder)
		end
	end

	local fallbackTools = FallbackWorld:FindFirstChild("EggTools")
	if fallbackTools then
		table.insert(roots, fallbackTools)
	end
	table.insert(roots, FallbackWorld)

	local mapped = TOOL_NAME_MAP[eggTypeName] or eggTypeName
	local candidates = {
		mapped,
		eggTypeName,
		eggTypeName:gsub("%s+", ""),
		eggTypeName:gsub("%s+Egg$", "Egg"),
		eggTypeName:gsub("%s+Egg$", ""),
	}

	for _, root in ipairs(roots) do
		for _, name in ipairs(candidates) do
			local found = root:FindFirstChild(name)
			if found and found:IsA("Tool") then
				return found
			end
		end
	end

	return nil
end

local function playHatchBurst(position: Vector3)
	local burstPart = Instance.new("Part")
	burstPart.Name = "HatchBurstEffect"
	burstPart.Size = Vector3.new(1, 1, 1)
	burstPart.Position = position + Vector3.new(0, 2, 0)
	burstPart.Anchored = true
	burstPart.CanCollide = false
	burstPart.CanTouch = false
	burstPart.CanQuery = false
	burstPart.Transparency = 1
	burstPart.Parent = Workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 215, 64))
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.85),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Lifetime = NumberRange.new(0.4, 0.85)
	emitter.Speed = NumberRange.new(6, 14)
	emitter.SpreadAngle = Vector2.new(360, 360)
	emitter.Parent = burstPart

	emitter:Emit(24)
	task.delay(1.2, function()
		if burstPart.Parent then
			burstPart:Destroy()
		end
	end)
end

local function onStationTouched(station: BasePart, hit: BasePart)
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return
	end

	local player = Players:GetPlayerFromCharacter(character)
	if not player or busyPlayers[player] then
		return
	end

	local now = os.clock()
	if lastTouchTime[player] and (now - lastTouchTime[player]) < TOUCH_COOLDOWN then
		return
	end

	local carriedFolder = character:FindFirstChild("CarriedEggs")
	if not carriedFolder then
		return
	end

	local entries = carriedFolder:GetChildren()
	if #entries == 0 then
		return
	end

	lastTouchTime[player] = now
	busyPlayers[player] = true

	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	local gaveAnyTool = false

	for _, entry in ipairs(entries) do
		local eggType = tostring(entry:GetAttribute("EggType") or entry.Name)
		local luckyPercent = entry:GetAttribute("LuckyPercent")
		local worldOrEvent = entry:GetAttribute("WorldOrEvent")

		local toolTemplate = findEggToolTemplate(
			eggType,
			if typeof(worldOrEvent) == "string" then worldOrEvent else nil
		)

		if toolTemplate and backpack then
			local toolClone = toolTemplate:Clone()
			for _, desc in ipairs(toolClone:GetDescendants()) do
				if desc:IsA("ProximityPrompt") then
					desc:Destroy()
				end
			end
			if luckyPercent ~= nil then
				toolClone:SetAttribute("LuckyPercent", luckyPercent)
			end
			toolClone.Parent = backpack
			gaveAnyTool = true
		else
			warn("[EggHatch] Missing Tool template for:", eggType, "or missing Backpack")
		end

		entry:Destroy()
	end

	if gaveAnyTool then
		playHatchBurst(station.Position)
	end

	busyPlayers[player] = nil
end

local function registerStation(inst: Instance)
	if not (inst:IsA("BasePart") and inst.Name == "EscapeStation") then
		return
	end
	if hookedStations[inst] then
		return
	end

	hookedStations[inst] = true
	inst.Anchored = true
	inst.CanTouch = true

	inst.Touched:Connect(function(hit: BasePart)
		onStationTouched(inst, hit)
	end)

	inst.Destroying:Connect(function()
		hookedStations[inst] = nil
	end)
end

for _, desc in ipairs(Workspace:GetDescendants()) do
	registerStation(desc)
end

Workspace.DescendantAdded:Connect(registerStation)

Players.PlayerRemoving:Connect(function(player: Player)
	busyPlayers[player] = nil
	lastTouchTime[player] = nil
end)]]></ProtectedString>
