					<ProtectedString name="Source"><![CDATA[
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local EggHatchConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("EggHatchConfig"))
local EggScaleConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("EggScaleConfig"))

local EggScaler = {}

local APPLIED_SCALE_ATTR = "_AppliedEggScale"
local ROLLED_SCALE_ATTR = "_RolledEggScale"
local DEFAULT_SCALE_ATTR = "_EggDefaultScale"
local PREPARED_ATTR = "_EggScalePrepared"

local function prepareParts(model)
	for _, object in ipairs(model:GetDescendants()) do
		if object:IsA("Weld")
			or object:IsA("WeldConstraint")
			or object:IsA("ManualWeld")
			or object:IsA("Motor6D")
			or object:IsA("RigidConstraint") then

			object:Destroy()

		elseif object:IsA("BasePart") then
			object.Anchored = true
		end
	end
end

function EggScaler.ResetScaleAttributes(eggModel)
	if not eggModel or not eggModel:IsA("Model") then
		return
	end

	eggModel:SetAttribute(APPLIED_SCALE_ATTR, nil)
	eggModel:SetAttribute(ROLLED_SCALE_ATTR, nil)
	eggModel:SetAttribute(DEFAULT_SCALE_ATTR, nil)
	eggModel:SetAttribute(PREPARED_ATTR, nil)
	eggModel:SetAttribute("EggScale", nil)
end

function EggScaler.GetTargetScale(eggModel)
	local savedScale = eggModel:GetAttribute(ROLLED_SCALE_ATTR)

	if typeof(savedScale) == "number" then
		return savedScale
	end

	local minScale, maxScale = EggScaleConfig.GetScaleBounds()
	local scale = EggScaleConfig.RollScale(eggModel)

	local multiplier = eggModel:GetAttribute("ScaleMultiplier")

	if typeof(multiplier) == "number" and multiplier > 0 then
		scale *= multiplier
	end

	return math.clamp(scale, minScale, maxScale)
end

function EggScaler.GetHeightOffset(eggModel)
	local baseOffset =
		EggHatchConfig.Settings.HeightOffset
		or EggScaleConfig.Settings.HeightOffsetFallback
		or 3.5

	if not EggScaleConfig.Settings.ScaleHeightMultiplier then
		return baseOffset
	end

	return baseOffset * EggScaler.GetTargetScale(eggModel)
end

-- Records the original size and rolls the final size only once.
-- It does NOT resize the egg. The client handles the animation.
function EggScaler.PrepareScale(eggModel)
	if not eggModel or not eggModel:IsA("Model") then
		return
	end

	if eggModel:GetAttribute(PREPARED_ATTR) then
		return
	end

	prepareParts(eggModel)

	local defaultScale = eggModel:GetScale()
	local targetScale = EggScaler.GetTargetScale(eggModel)

	eggModel:SetAttribute(DEFAULT_SCALE_ATTR, defaultScale)
	eggModel:SetAttribute(ROLLED_SCALE_ATTR, targetScale)
	eggModel:SetAttribute("EggScale", targetScale)
	eggModel:SetAttribute(APPLIED_SCALE_ATTR, defaultScale)

	eggModel:SetAttribute(PREPARED_ATTR, true)
end

function EggScaler.ApplyScale(eggModel, _, force)
	if not eggModel or not eggModel:IsA("Model") then
		return
	end

	prepareParts(eggModel)

	local targetScale = EggScaler.GetTargetScale(eggModel)
	local currentScale = eggModel:GetAttribute(APPLIED_SCALE_ATTR)

	if not force
		and typeof(currentScale) == "number"
		and math.abs(currentScale - targetScale) < 0.0001 then
		return
	end

	eggModel:ScaleTo(targetScale)

	eggModel:SetAttribute(APPLIED_SCALE_ATTR, targetScale)
	eggModel:SetAttribute("EggScale", targetScale)
end

-- Finds the RoamPets surface directly underneath/around the egg.
function EggScaler.FindSurface(eggModel)
	if not eggModel then
		return nil
	end

	local bases = Workspace:FindFirstChild("Bases")
	if not bases then
		return nil
	end

	local eggPosition = eggModel:GetPivot().Position
	local closestPart = nil
	local closestDistance = math.huge

	for _, object in ipairs(bases:GetDescendants()) do
		if object:IsA("BasePart") and object.Name == "RoamPets" then
			local localPosition =
				object.CFrame:PointToObjectSpace(eggPosition)

			local halfSize = object.Size * 0.5

			local insideX =
				math.abs(localPosition.X) <= halfSize.X + 2

			local insideZ =
				math.abs(localPosition.Z) <= halfSize.Z + 2

			if insideX and insideZ then
				local distance =
					(object.Position - eggPosition).Magnitude

				if distance < closestDistance then
					closestDistance = distance
					closestPart = object
				end
			end
		end
	end

	return closestPart
end

-- Keeps the bottom of the egg on the top of a horizontal RoamPets part.
function EggScaler.GroundOnSurface(eggModel, surface, extraGap)
	if not eggModel or not eggModel:IsA("Model") then
		return
	end

	if not surface or not surface:IsA("BasePart") then
		return
	end

	local pivot = eggModel:GetPivot()
	local boxCF, boxSize = eggModel:GetBoundingBox()

	local eggBottomY = boxCF.Position.Y - boxSize.Y * 0.5
	local surfaceTopY = surface.Position.Y + surface.Size.Y * 0.5

	local gap = tonumber(extraGap) or 0.02
	local correctionY = surfaceTopY + gap - eggBottomY

	eggModel:PivotTo(
		pivot + Vector3.new(0, correctionY, 0)
	)
end

function EggScaler.PlaceOnSurface(eggModel, baseCFrame, surfaceY, extraGap)
	if not eggModel or not eggModel:IsA("Model") then
		return
	end

	local cf = typeof(baseCFrame) == "CFrame"
		and baseCFrame
		or eggModel:GetPivot()

	local pivot = eggModel:GetPivot()
	local boxCF, boxSize = eggModel:GetBoundingBox()

	local bottomY = boxCF.Position.Y - boxSize.Y * 0.5
	local bottomOffset = bottomY - pivot.Position.Y

	local targetSurfaceY = tonumber(surfaceY) or cf.Position.Y
	local gap = tonumber(extraGap) or 0.02
	local targetPivotY = targetSurfaceY + gap - bottomOffset

	local rotation = cf - cf.Position

	eggModel:PivotTo(
		CFrame.new(cf.Position.X, targetPivotY, cf.Position.Z) * rotation
	)
end

return EggScaler
]]></ProtectedString>
