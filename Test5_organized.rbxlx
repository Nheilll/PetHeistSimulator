					<Item class="LocalScript" referent="RBX5792483FCB714E8B80493F7A6D0DB020">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PlaceEggEvent = ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("Base"):WaitForChild("PlaceEggEvent")

local tool = script.Parent
local MAX_PLACE_DISTANCE = 25

tool.Activated:Connect(function()
	local player = game.Players.LocalPlayer
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	local mouse = player:GetMouse()
	local hitPos = mouse.Hit.Position

	if (hitPos - rootPart.Position).Magnitude <= MAX_PLACE_DISTANCE then
		PlaceEggEvent:FireServer(tool, hitPos)
	end
end)
]]></ProtectedString>
