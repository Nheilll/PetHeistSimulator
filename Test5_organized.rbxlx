				<Properties>
					<ProtectedString name="Source"><![CDATA[
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local bases = Workspace:WaitForChild("Bases")

-- SETTINGS
local REQUIRED_CRACKS = 3
local PROMPT_NAME = "EggCrackPrompt"
local MAX_DISTANCE = 10

-- Create RemoteEvent automatically.
local remoteFolder = ReplicatedStorage:FindFirstChild("RemoteEvents")

if not remoteFolder then
	remoteFolder = Instance.new("Folder")
	remoteFolder.Name = "RemoteEvents"
	remoteFolder.Parent = ReplicatedStorage
end

local crackAnimationEvent = remoteFolder:FindFirstChild("EggCrackAnimation")

if not crackAnimationEvent then
	crackAnimationEvent = Instance.new("RemoteEvent")
	crackAnimationEvent.Name = "EggCrackAnimation"
	crackAnimationEvent.Parent = remoteFolder
end

local ANIMATION_DURATION = 0.65

local connectedEggs = {}
local busyEggs = {}

local function getRootPart(egg)
	if egg.PrimaryPart then
		return egg.PrimaryPart
	end

	local root = egg:FindFirstChildWhichIsA("BasePart", true)

	if root then
		egg.PrimaryPart = root
	end

	return root
end

local function updatePrompt(prompt, egg)
	local cracks = egg:GetAttribute("CrackCount") or 0

	if cracks >= REQUIRED_CRACKS then
		prompt.ActionText = "Cracked!"
		prompt.Enabled = false
		return
	end

	prompt.ActionText = string.format(
		"Crack (%d/%d)",
		cracks,
		REQUIRED_CRACKS
	)

	prompt.Enabled =
		egg:GetAttribute("HatchReady") == true
		and not busyEggs[egg]
end

local function setupEgg(egg)
	if not egg:IsA("Model") or connectedEggs[egg] then
		return
	end

	if not egg:GetAttribute("EggType") then
		return
	end

	local root = getRootPart(egg)

	if not root then
		return
	end

	connectedEggs[egg] = true

	local prompt = root:FindFirstChild(PROMPT_NAME)

	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = PROMPT_NAME
		prompt.Parent = root
	end

	prompt.ActionText = "Crack (0/3)"
	prompt.ObjectText = "Egg"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = MAX_DISTANCE
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false

	if typeof(egg:GetAttribute("CrackCount")) ~= "number" then
		egg:SetAttribute("CrackCount", 0)
	end

	egg:GetAttributeChangedSignal("HatchReady"):Connect(function()
		updatePrompt(prompt, egg)
	end)

	egg:GetAttributeChangedSignal("CrackCount"):Connect(function()
		updatePrompt(prompt, egg)
	end)

	updatePrompt(prompt, egg)

	prompt.Triggered:Connect(function(player)
		if not egg.Parent then
			return
		end

		if busyEggs[egg] then
			return
		end

		if egg:GetAttribute("HatchReady") ~= true then
			return
		end

		if egg:GetAttribute("HatchRequested") == true then
			return
		end

		-- Check ownership.
		local ownerId = egg:GetAttribute("PlacedByUserId")

		if typeof(ownerId) == "number" and ownerId ~= player.UserId then
			return
		end

		local currentCracks = egg:GetAttribute("CrackCount") or 0

		if currentCracks >= REQUIRED_CRACKS then
			return
		end

		busyEggs[egg] = true
		prompt.Enabled = false

		currentCracks += 1

		egg:SetAttribute("CrackCount", currentCracks)

		-- Tell every client to animate this egg.
		crackAnimationEvent:FireAllClients(
			egg,
			currentCracks
		)

		print(
			player.Name,
			"cracked",
			egg.Name,
			currentCracks,
			"/",
			REQUIRED_CRACKS
		)

		-- Wait for the client-side animation duration.
		task.wait(ANIMATION_DURATION)

		if not egg.Parent then
			busyEggs[egg] = nil
			return
		end

		-- Third crack completed.
		if currentCracks >= REQUIRED_CRACKS then
			egg:SetAttribute("HatchRequested", true)

			print("EGG FULLY CRACKED:", egg.Name)
		else
			busyEggs[egg] = nil
			updatePrompt(prompt, egg)
		end
	end)
end

-- Existing eggs.
for _, object in ipairs(bases:GetDescendants()) do
	if object:IsA("Model") then
		task.defer(setupEgg, object)
	end
end

-- Newly placed eggs.
bases.DescendantAdded:Connect(function(object)
	if object:IsA("Model") then
		task.defer(setupEgg, object)
	end
end)
]]></ProtectedString>
