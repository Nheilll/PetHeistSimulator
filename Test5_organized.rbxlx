					<token name="RunContext">0</token>
					<string name="ScriptGuid">{907CA2AB-4B08-4293-8599-E7893919CAC3}</string>
					<BinaryString name="AttributesSerialize"/>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">PetHatchServer</string>
					<BinaryString name="SerializedOverrides"/>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">772ae72598bd3d04cbe437b4bc4daac4</UniqueId>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX81AB0938719945CA87980047836BFEE5">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- Script: ServerScriptService/PetServerScripts/PetToolServer
--
-- PET BAG  <->  HOTBAR
--   GrantPetTool (Equip)   : puts the pet's Tool on the hotbar (Backpack).
--   StorePetTool (Unequip) : removes the Tool from the hotbar / hand,
--                            so the pet is "back in the Pet Bag".
--
-- The pet itself always stays in the player's PetInventory.
-- Only the Tool (the hotbar item) is created / removed.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PetConfig = require(
	ReplicatedStorage:WaitForChild("Config"):WaitForChild("PetConfig")
)

local remotes = ReplicatedStorage:WaitForChild("RemoteEvents")

-- Create the remote if it is missing so this script can never hang.
local function getRemote(name: string): RemoteEvent
	local remote = remotes:FindFirstChild(name)

	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = remotes
	end

	return remote :: RemoteEvent
end

local equipEvent = getRemote("GrantPetTool")
local unequipEvent = getRemote("StorePetTool")

local COOLDOWN = 0.15
local OWNERSHIP_WAIT = 10 -- seconds to wait for a fresh hatch to be saved

local lastAction: { [Player]: { [string]: number } } = {}

--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function normalizePetName(name: string): string
	local stripped = name:gsub("^animal%-", ""):gsub("^pet%-", "")

	if stripped == "" then
		return string.lower(name)
	end

	return string.lower(stripped)
end

local function canAct(player: Player, action: string): boolean
	local now = os.clock()
	local bucket = lastAction[player]

	if not bucket then
		bucket = {}
		lastAction[player] = bucket
	end

	if now - (bucket[action] or 0) < COOLDOWN then
		return false
	end

	bucket[action] = now
	return true
end

-- How many copies of this pet the player owns.
local function getOwnedCount(player: Player, petName: string): number
	local inventory = player:FindFirstChild("PetInventory")

	if not inventory then
		return 0
	end

	local target = normalizePetName(petName)

	for _, child in ipairs(inventory:GetChildren()) do
		if child:IsA("IntValue") and normalizePetName(child.Name) == target then
			return math.max(0, child.Value)
		end
	end

	return 0
end

-- A pet that just hatched may not be in PetInventory for a moment.
local function waitForOwnership(player: Player, petName: string): number
	local deadline = os.clock() + OWNERSHIP_WAIT

	while player.Parent == Players and os.clock() < deadline do
		local count = getOwnedCount(player, petName)

		if count > 0 then
			return count
		end

		task.wait(0.25)
	end

	return getOwnedCount(player, petName)
end

local function toolPetName(tool: Tool): string
	local attr = tool:GetAttribute("PetName")

	if typeof(attr) == "string" and attr ~= "" then
		return attr
	end

	return tool.Name
end

-- Every pet Tool the player has (hotbar + currently held).
local function getPlayerPetTools(player: Player, petName: string?): { Tool }
	local found: { Tool } = {}
	local target = if petName then normalizePetName(petName) else nil

	local containers = {
		player:FindFirstChildOfClass("Backpack"),
		player.Character,
	}

	for _, container in ipairs(containers) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") and child:GetAttribute("IsPetTool") == true then
					if not target or normalizePetName(toolPetName(child)) == target then
						table.insert(found, child)
					end
				end
			end
		end
	end

	return found
end

-- Looks in World1/PetTools, World2/PetTools, ...
local function findPetToolTemplate(petName: string): Tool?
	local target = normalizePetName(petName)

	for _, world in ipairs(ReplicatedStorage:GetChildren()) do
		if world.Name:match("^World%d+$") then
			local petTools = world:FindFirstChild("PetTools")

			if petTools then
				for _, tool in ipairs(petTools:GetChildren()) do
					if tool:IsA("Tool") and normalizePetName(tool.Name) == target then
						return tool
					end
				end
			end
		end
	end

	return nil
end

--------------------------------------------------
-- EQUIP  (Pet Bag -> Hotbar)
--------------------------------------------------

equipEvent.OnServerEvent:Connect(function(player: Player, petName: unknown)
	if typeof(petName) ~= "string" or petName == "" then
		return
	end

	if not canAct(player, "Equip") then
		return
	end

	local owned = waitForOwnership(player, petName)

	if owned <= 0 then
		return
	end

	-- One Tool per copy owned (2 cats = up to 2 cat Tools).
	if #getPlayerPetTools(player, petName) >= owned then
		return
	end

	local backpack = player:FindFirstChildOfClass("Backpack")

	if not backpack then
		return
	end

	local template = findPetToolTemplate(petName)

	if not template then
		warn("[PetToolServer] Missing pet Tool in World#/PetTools:", petName)
		return
	end

	local _, rarity = PetConfig.FindPet(petName)
	local displayName = PetConfig.GetDisplayName(petName)

	local tool = template:Clone()
	tool.Name = displayName
	tool.ToolTip = displayName
	tool:SetAttribute("PetName", petName)
	tool:SetAttribute("IsPetTool", true)

	if rarity then
		tool:SetAttribute("Rarity", rarity)
	end

	-- Lands on the hotbar. It is NOT forced into the player's hand.
	tool.Parent = backpack
end)

--------------------------------------------------
-- UNEQUIP  (Hotbar / Hand -> Pet Bag)
--
--   FireServer(petName)        removes ONE tool of that pet
--   FireServer(nil, true)      removes ALL pet tools
--------------------------------------------------

unequipEvent.OnServerEvent:Connect(function(
	player: Player,
	petName: unknown,
	removeAll: unknown
)
	if not canAct(player, "Unequip") then
		return
	end

	if removeAll == true then
		for _, tool in ipairs(getPlayerPetTools(player, nil)) do
			tool:Destroy()
		end

		return
	end

	if typeof(petName) ~= "string" or petName == "" then
		return
	end

	local tools = getPlayerPetTools(player, petName)

	-- Prefer the one sitting on the hotbar over the one in hand.
	local backpack = player:FindFirstChildOfClass("Backpack")
	local chosen = tools[1]

	for _, tool in ipairs(tools) do
		if tool.Parent == backpack then
			chosen = tool
			break
		end
	end

	if chosen then
		chosen:Destroy()
	end
end)

Players.PlayerRemoving:Connect(function(player: Player)
	lastAction[player] = nil
end)

print("[PetToolServer] Pet bag <-> hotbar system loaded.")
]]></ProtectedString>
