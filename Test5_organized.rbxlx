				<Content name="LinkedSource"><null/></Content>
				<ProtectedString name="Source"><![CDATA[local EggHatchConfig = {}

EggHatchConfig.Settings = {
	TimerGuiName = "HatchTimerGui",
	TimerLabelName = "TimerLabel",
	RarityLabelName = "RarityLabel",
	HeightOffset = 3.5,
	UpdateInterval = 0.25,
	ScanAllBases = true,
	PromptHoldDuration = 0.5,
	PromptMaxDistance = 12,
}

EggHatchConfig.Eggs = {
	CommonEgg = {
		DisplayName = "Common Egg",
		Rarity = "Common",
		Duration = 5,
		LuckyPercent = 75,
	},
	UncommonEgg = {
		DisplayName = "Uncommon Egg",
		Rarity = "Uncommon",
		Duration = 10,
		LuckyPercent = 50,
	},
	RareEgg = {
		DisplayName = "Rare Egg",
		Rarity = "Rare",
		Duration = 300,
		LuckyPercent = 30,
	},
	EpicEgg = {
		DisplayName = "Epic Egg",
		Rarity = "Epic",
		Duration = 600,
		LuckyPercent = 15,
	},
	LegendaryEgg = {
		DisplayName = "Legendary Egg",
		Rarity = "Legendary",
		Duration = 1200,
		LuckyPercent = 5,
	},
	MythicEgg = {
		DisplayName = "Mythic Egg",
		Rarity = "Mythic",
		Duration = 2400,
		LuckyPercent = 1,
	},
}

-- The Legendary egg tool is named "Legendary" (not "LegendaryEgg"), so accept both.
EggHatchConfig.Eggs.Legendary = EggHatchConfig.Eggs.LegendaryEgg

local function normalizeKey(eggType)
	if typeof(eggType) ~= "string" then
		return ""
	end
	return eggType:gsub("%s+", "")
end

function EggHatchConfig.GetEggData(eggType)
	local key = normalizeKey(eggType)
	local entry = EggHatchConfig.Eggs[key]

	if entry then
		return {
			DisplayName = entry.DisplayName or eggType,
			Rarity = entry.Rarity or "Common",
			Duration = entry.Duration or 60,
			LuckyPercent = entry.LuckyPercent or 0,
		}
	end

	return {
		DisplayName = tostring(eggType or "Egg"),
		Rarity = "Common",
		Duration = 60,
		LuckyPercent = 0,
	}
end

return EggHatchConfig]]></ProtectedString>
				<string name="ScriptGuid">{FA5CD8C1-0DCC-46B5-B08C-12C3F7627E0E}</string>
