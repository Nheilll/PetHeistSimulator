			<Item class="Script" referent="RBXFDC77FD8CC914C219B0BCEF5F767AD5E">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local eggPlacedEvent = ReplicatedStorage
	:WaitForChild("RemoteEvents")
	:WaitForChild("EggPlacedEvent")

local basesRoot = Workspace:WaitForChild("Bases")
local mainWorld = basesRoot:FindFirstChild("MainWorld")

-- SETTINGS
local MAX_DISTANCE = 30
local MAX_SPOT_SNAP_DISTANCE = 12
local MIN_SPACING = 3
local EDGE_PADDING = 1
local DEFAULT_HATCH_SECONDS = 30

-- Per-egg hatch times in seconds (optional; falls back to DEFAULT_HATCH_SECONDS)
local HATCH_TIMES = {
	-- BasicEgg = 15,
	-- RareEgg = 60,
}

-- Change these if your egg's front axis needs correction.
local ROTATION_OFFSET = Vector3.new(0, 0, 180)

--------------------------------------------------
-- GET PLAYER BASE
--------------------------------------------------

local function getPlayerBase(player)
	local assignedName = player:GetAttribute("AssignedBase")

	if assignedName then
		local base = mainWorld:FindFirstChild(assignedName)
		if base then
			return base
		end
	end

	return mainWorld:FindFirstChild("Base1")
end

--------------------------------------------------
-- CHECK PLACED EGGS
--------------------------------------------------

local function isPlacedEgg(instance)
	return instance:IsA("Model")
		and instance:GetAttribute("EggType") ~= nil
end

--------------------------------------------------
-- GET SPOT CFRAME & TOP POSITION
--------------------------------------------------

local function getSpotCFrame(spot)
	if spot:IsA("BasePart") then
		return spot.CFrame
	elseif spot:IsA("Model") then
		return spot:GetPivot()
	end
	return nil
end

local function getSpotTopPosition(spot)
	if spot:IsA("BasePart") then
		return Vector3.new(
			spot.Position.X,
			spot.Position.Y + spot.Size.Y / 2,
			spot.Position.Z
		)
	elseif spot:IsA("Model") then
		local cf, size = spot:GetBoundingBox()
		return Vector3.new(
			cf.Position.X,
			cf.Position.Y + size.Y / 2,
			cf.Position.Z
		)
	end
	return nil
end

--------------------------------------------------
-- FIND TARGET SPOT
--------------------------------------------------

local function findTargetSpot(folder, requestedTarget, hitPosition)
	if not folder then
		return nil
	end

	if typeof(requestedTarget) == "Instance"
		and requestedTarget:IsDescendantOf(folder) then

		local current = requestedTarget

		while current and current.Parent ~= folder do
			current = current.Parent
		end

		if current
			and not isPlacedEgg(current)
			and (current:IsA("BasePart") or current:IsA("Model")) then
			return current
		end
	end

	local closestSpot = nil
	local closestDistance = MAX_SPOT_SNAP_DISTANCE

	for _, child in ipairs(folder:GetChildren()) do
		if not isPlacedEgg(child)
			and (child:IsA("BasePart") or child:IsA("Model")) then

			local topPosition = getSpotTopPosition(child)

			if topPosition then
				local distance = (
					Vector3.new(hitPosition.X, 0, hitPosition.Z)
					- Vector3.new(topPosition.X, 0, topPosition.Z)
				).Magnitude

				if distance < closestDistance then
					closestDistance = distance
					closestSpot = child
				end
			end
		end
	end

	return closestSpot
end

--------------------------------------------------
-- CHECK IF SPOT IS OCCUPIED / HAS ROOM
--------------------------------------------------

local function isSpotOccupied(folder, spot)
	local topPosition = getSpotTopPosition(spot)

	if not topPosition then
		return true
	end

	for _, model in ipairs(folder:GetChildren()) do
		if isPlacedEgg(model) then
			local position = model:GetPivot().Position

			local distance = (
				Vector3.new(position.X, 0, position.Z)
				- Vector3.new(topPosition.X, 0, topPosition.Z)
			).Magnitude

			if distance < MIN_SPACING then
				return true
			end
		end
	end

	return false
end

local function hasRoom(folder, position)
	for _, model in ipairs(folder:GetChildren()) do
		if isPlacedEgg(model) then
			local p = model:GetPivot().Position

			local distance = (
				Vector3.new(p.X, 0, p.Z)
				- Vector3.new(position.X, 0, position.Z)
			).Magnitude

			if distance < MIN_SPACING then
				return false
			end
		end
	end

	return true
end

--------------------------------------------------
-- CLAMP POSITION TO ROAM PETS
--------------------------------------------------

local function clampToRoamPets(roamPets, hitPosition)
	local localHit = roamPets.CFrame:PointToObjectSpace(hitPosition)

	local halfX = math.max(0.1, roamPets.Size.X / 2 - EDGE_PADDING)
	local halfZ = math.max(0.1, roamPets.Size.Z / 2 - EDGE_PADDING)

	local clamped = Vector3.new(
		math.clamp(localHit.X, -halfX, halfX),
		roamPets.Size.Y / 2,
		math.clamp(localHit.Z, -halfZ, halfZ)
	)

	return roamPets.CFrame:PointToWorldSpace(clamped)
end

--------------------------------------------------
-- CREATE PLACED EGG MODEL
--------------------------------------------------

local function stripWelds(model)
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("Weld")
			or descendant:IsA("WeldConstraint")
			or descendant:IsA("ManualWeld")
			or descendant:IsA("Motor6D")
			or descendant:IsA("RigidConstraint")
		then
			descendant:Destroy()
		end
	end
end

local function createPlacedModel(tool, targetPosition, targetCFrame, folder, ownerUserId)
	local clone = tool:Clone()

	local model = Instance.new("Model")
	model.Name = tool.Name

	local hatchDuration = tool:GetAttribute("HatchDuration")
		or HATCH_TIMES[tool.Name]
		or DEFAULT_HATCH_SECONDS

	model:SetAttribute("EggType", tool.Name)
	model:SetAttribute("PlacedByUserId", ownerUserId)
	model:SetAttribute("HatchDuration", hatchDuration)
	model:SetAttribute("PlacedAt", workspace:GetServerTimeNow())
	model:SetAttribute("HatchReady", false)

	for _, child in ipairs(clone:GetChildren()) do
		if child:IsA("Script")
			or child:IsA("LocalScript")
			or child:IsA("ProximityPrompt") then
			child:Destroy()
		else
			child.Parent = model
		end
	end

	clone:Destroy()

	-- Remove welds/joints inherited from the Tool before positioning or scaling
	stripWelds(model)

	local parts = {}

	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end

	if #parts == 0 then
		model:Destroy()
		return nil
	end

	local handle = model:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") then
		model.PrimaryPart = handle
	else
		model.PrimaryPart = parts[1]
	end

	local spotRotation = targetCFrame - targetCFrame.Position
	local offsetRotation = CFrame.Angles(
		math.rad(ROTATION_OFFSET.X),
		math.rad(ROTATION_OFFSET.Y),
		math.rad(ROTATION_OFFSET.Z)
	)

	model:PivotTo(CFrame.new(targetPosition) * (spotRotation * offsetRotation))

	local boxCFrame, boxSize = model:GetBoundingBox()
	local bottomCenter = Vector3.new(
		boxCFrame.Position.X,
		boxCFrame.Position.Y - boxSize.Y / 2,
		boxCFrame.Position.Z
	)

	model:PivotTo(model:GetPivot() + (targetPosition - bottomCenter))

	for _, part in ipairs(parts) do
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = true
	end

	model.Parent = folder

	return model
end

--------------------------------------------------
-- EGG PLACEMENT EVENT
--------------------------------------------------

eggPlacedEvent.OnServerEvent:Connect(function(
	player,
	tool,
	hitPosition,
	requestedTarget
)
	if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then
		return
	end

	if typeof(hitPosition) ~= "Vector3" then
		return
	end

	if not player.Character or tool.Parent ~= player.Character then
		return
	end

	local base = getPlayerBase(player)
	if not base then
		return
	end

	local eggPlaceSpots = base:FindFirstChild("EggPlaceSpots")
	if not eggPlaceSpots or not eggPlaceSpots:IsA("Folder") then
		warn("EggPlaceSpots folder not found!")
		return
	end

	local roamPets = base:FindFirstChild("RoamPets")
	if not roamPets or not roamPets:IsA("BasePart") then
		return
	end

	local root = player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	if (root.Position - hitPosition).Magnitude > MAX_DISTANCE then
		return
	end

	local spot = findTargetSpot(eggPlaceSpots, requestedTarget, hitPosition)
	local surfacePosition
	local targetCFrame

	if spot then
		surfacePosition = getSpotTopPosition(spot)
		targetCFrame = getSpotCFrame(spot)

		if not surfacePosition or not targetCFrame then
			return
		end

		if isSpotOccupied(eggPlaceSpots, spot) then
			return
		end
	else
		if requestedTarget ~= roamPets then
			return
		end

		surfacePosition = clampToRoamPets(roamPets, hitPosition)
		targetCFrame = roamPets.CFrame

		if not hasRoom(eggPlaceSpots, surfacePosition) then
			return
		end
	end

	local placed = createPlacedModel(
		tool,
		surfacePosition,
		targetCFrame,
		eggPlaceSpots,
		player.UserId
	)

	if not placed then
		return
	end

	tool:Destroy()
end)]]></ProtectedString>
