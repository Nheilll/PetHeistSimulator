				<Properties>
					<ProtectedString name="Source"><![CDATA[
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local EggHatchConfig = require(
	ReplicatedStorage:WaitForChild("Config"):WaitForChild("EggHatchConfig")
)

local EggScaler = require(
	script.Parent:WaitForChild("EggScaler")
)

local bases = Workspace:WaitForChild("Bases")
local settings = EggHatchConfig.Settings

local GUI_TEMPLATE_NAME = settings.TimerGuiName or "EggTimerGui"
local TIMER_LABEL_NAME = settings.TimerLabelName or "TimerLabel"
local RARITY_LABEL_NAME = settings.RarityLabelName or "RarityLabel"

local EXTRA_GAP = 0.02

local DEFAULT_HATCH_TIME = settings.HatchTime
	or settings.HatchDuration
	or 60

local runningEggs = {}

local function getEggData(egg)
	local eggType = egg:GetAttribute("EggType")

	if not eggType then
		return nil
	end

	local success, data = pcall(function()
		return EggHatchConfig.GetEggData(eggType)
	end)

	if success then
		return data
	end

	warn("Could not get egg data:", eggType, data)
	return nil
end

local function getRootPart(egg)
	if egg.PrimaryPart then
		return egg.PrimaryPart
	end

	local root = egg:FindFirstChildWhichIsA("BasePart", true)

	if root then
		egg.PrimaryPart = root
	end

	return root
end

local function getHatchDuration(data)
	if data then
		local duration = data.Duration or data.HatchTime or data.HatchDuration

		if typeof(duration) == "number" and duration >= 0 then
			return duration
		end
	end

	return DEFAULT_HATCH_TIME
end

local function formatTime(seconds)
	seconds = math.max(0, math.ceil(seconds))

	local minutes = math.floor(seconds / 60)
	local remainingSeconds = seconds % 60

	return string.format("%02d:%02d", minutes, remainingSeconds)
end

local function getRarity(data)
	if not data then
		return "Unknown"
	end

	return tostring(data.Rarity or data.rarity or "Unknown")
end

local function updateGui(egg, data, remaining)
	local gui = egg:FindFirstChild(GUI_TEMPLATE_NAME, true)

	if not gui or not gui:IsA("BillboardGui") then
		return
	end

	local root = getRootPart(egg)

	if not root then
		return
	end

	gui.Adornee = root
	gui.Enabled = true

	local timerLabel = gui:FindFirstChild(TIMER_LABEL_NAME, true)
	local rarityLabel = gui:FindFirstChild(RARITY_LABEL_NAME, true)

	if timerLabel and timerLabel:IsA("TextLabel") then
		if remaining <= 0 then
			timerLabel.Text = "READY TO CRACK!"
		else
			timerLabel.Text = formatTime(remaining)
		end
	end

	if rarityLabel and rarityLabel:IsA("TextLabel") then
		rarityLabel.Text = getRarity(data)
	end

	local boxCF, boxSize = egg:GetBoundingBox()
	local eggTopY = boxCF.Position.Y + boxSize.Y * 0.5

	local offsetY = eggTopY - root.Position.Y + 0.5

	gui.StudsOffset = Vector3.new(0, offsetY, 0)
end

local function createGui(egg)
	local root = getRootPart(egg)

	if not root then
		warn("Egg has no BasePart:", egg:GetFullName())
		return nil
	end

	local existing = egg:FindFirstChild(GUI_TEMPLATE_NAME, true)

	if existing and existing:IsA("BillboardGui") then
		existing.Adornee = root
		return existing
	end

	local template = ReplicatedStorage:FindFirstChild(
		GUI_TEMPLATE_NAME,
		true
	)

	if not template or not template:IsA("BillboardGui") then
		warn("Missing BillboardGui template:", GUI_TEMPLATE_NAME)
		return nil
	end

	local gui = template:Clone()
	gui.Name = GUI_TEMPLATE_NAME
	gui.Adornee = root
	gui.Enabled = true
	gui.Parent = egg

	return gui
end

local function startEgg(egg)
	if not egg:IsA("Model") or runningEggs[egg] then
		return
	end

	if not egg:GetAttribute("EggType") then
		return
	end

	runningEggs[egg] = true

	task.spawn(function()
		local data = getEggData(egg)

		if not egg.Parent then
			runningEggs[egg] = nil
			return
		end

		-- Prepare egg scaling.
		EggScaler.PrepareScale(egg)

		-- Keep egg grounded on RoamPets.
		local surface = EggScaler.FindSurface(egg)

		if surface then
			EggScaler.GroundOnSurface(egg, surface, EXTRA_GAP)
		else
			warn("No RoamPets surface found for:", egg:GetFullName())
		end

		createGui(egg)

		local hatchDuration = getHatchDuration(data)

		local placedAt = egg:GetAttribute("PlacedAt")

		if typeof(placedAt) ~= "number" then
			placedAt = os.time()
			egg:SetAttribute("PlacedAt", placedAt)
		end

		local hatchAt = placedAt + hatchDuration

		while egg.Parent do
			local remaining = hatchAt - os.time()

			if remaining <= 0 then
				egg:SetAttribute("HatchReady", true)

				updateGui(egg, data, 0)
				break
			end

			egg:SetAttribute("HatchReady", false)

			updateGui(egg, data, remaining)

			task.wait(1)
		end

		runningEggs[egg] = nil
	end)
end

-- Existing eggs.
for _, object in ipairs(bases:GetDescendants()) do
	if object:IsA("Model") then
		startEgg(object)
	end
end

-- Newly placed eggs.
bases.DescendantAdded:Connect(function(object)
	if object:IsA("Model") then
		task.defer(startEgg, object)
	end
end)
]]></ProtectedString>
