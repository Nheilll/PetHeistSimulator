				</Properties>
			</Item>
				<Item class="LocalScript" referent="RBX04FDF3B9DAC44AB3B570A47D1E48081B">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

local player = Players.LocalPlayer

local RAISE_ANIMATION_ID = "rbxassetid://79095222851157"
local RAISE_ANIM_PRIORITY = Enum.AnimationPriority.Action

local TOOL_TO_EGG_NAME = {
	CommonEgg = "Common Egg",
	UncommonEgg = "Uncommon Egg",
	RareEgg = "Rare Egg",
	EpicEgg = "Epic Egg",
	Legendary = "Legendary Egg",
	MythicEgg = "Mythic Egg",
}

local activeTrack: AnimationTrack? = nil
local activeTool: Tool? = nil

local function isEggTool(inst: Instance): boolean
	if not inst:IsA("Tool") then
		return false
	end
	return TOOL_TO_EGG_NAME[inst.Name] ~= nil or inst.Name:find("Egg") ~= nil
end

local function normalizeAnimationId(rawId: string): string
	local trimmed = rawId:match("^%s*(.-)%s*$") or ""
	if trimmed == "" then
		return ""
	end
	if trimmed:match("^rbxassetid://") or trimmed:match("^http[s]?://") then
		return trimmed
	end
	return "rbxassetid://" .. trimmed
end

local function resolveAnimationId(tool: Tool): string?
	local attrId = tool:GetAttribute("EquipAnimationId")
	if typeof(attrId) == "string" and attrId ~= "" then
		return normalizeAnimationId(attrId)
	end

	local childAnim = tool:FindFirstChildWhichIsA("Animation", true)
	if childAnim and childAnim.AnimationId ~= "" then
		return normalizeAnimationId(childAnim.AnimationId)
	end

	if RAISE_ANIMATION_ID ~= "" then
		return normalizeAnimationId(RAISE_ANIMATION_ID)
	end

	return nil
end

local function stopRaiseAnimation()
	activeTool = nil
	if activeTrack then
		pcall(function()
			activeTrack:Stop(0.15)
			activeTrack:Destroy()
		end)
		activeTrack = nil
	end
end

local function playRaiseAnimation(character: Model, tool: Tool)
	stopRaiseAnimation()

	local animId = resolveAnimationId(tool)
	if not animId or animId == "" then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end

	local anim = Instance.new("Animation")
	anim.AnimationId = animId

	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	anim:Destroy()

	if not ok or not track then
		warn("[EggRaiseAnim] Failed to load animation:", animId, track)
		return
	end

	track.Priority = RAISE_ANIM_PRIORITY
	track.Looped = true

	local playOk, playErr = pcall(function()
		track:Play(0.15)
	end)
	if not playOk then
		warn("[EggRaiseAnim] Failed to play animation:", animId, playErr)
		return
	end

	activeTool = tool
	activeTrack = track
end

local function hookTool(item: Instance)
	if not isEggTool(item) then
		return
	end
	local tool = item :: Tool
	if tool:GetAttribute("RaiseAnimHooked") then
		return
	end
	tool:SetAttribute("RaiseAnimHooked", true)

	tool.Equipped:Connect(function()
		if player.Character then
			playRaiseAnimation(player.Character, tool)
		end
	end)

	tool.Unequipped:Connect(function()
		if activeTool == tool then
			stopRaiseAnimation()
		end
	end)

	tool.Destroying:Connect(function()
		if activeTool == tool then
			stopRaiseAnimation()
		end
	end)
end

local function watchContainer(container: Instance)
	for _, child in ipairs(container:GetChildren()) do
		hookTool(child)
	end
	container.ChildAdded:Connect(hookTool)
end

local function hookCharacter(character: Model)
	stopRaiseAnimation()

	for _, child in ipairs(character:GetChildren()) do
		if isEggTool(child) then
			hookTool(child)
			playRaiseAnimation(character, child :: Tool)
		end
	end

	character.ChildAdded:Connect(function(child)
		if isEggTool(child) then
			hookTool(child)
			playRaiseAnimation(character, child :: Tool)
		end
	end)

	character.ChildRemoved:Connect(function(child)
		if child == activeTool then
			stopRaiseAnimation()
		end
	end)
end

if player:FindFirstChild("Backpack") then
	watchContainer(player.Backpack)
end
player.ChildAdded:Connect(function(child)
	if child.Name == "Backpack" then
		watchContainer(child)
	end
end)

if player.Character then
	hookCharacter(player.Character)
end
player.CharacterAdded:Connect(hookCharacter)]]></ProtectedString>
